+            return out
+        except c.PlanningRefusal as error:
+            refusals.append(str(error)[-240:])
+    raise c.PlanningRefusal('No screened donor exit: '+str(refusals[-2:]))
+
+
 def _release_execute(ctx,state,arm,position,rotation,phase):
     belief=transfer._belief(ctx,state);plan=transfer._plan(ctx,arm,[(position,rotation)])
     full=transfer._qpath(plan,belief['current_robot_encoder_values'],arm)
diff -ruN '--exclude=__pycache__' clean/policy/puzzler/free_arm_motion.py A/policy/puzzler/free_arm_motion.py
--- a/policy/puzzler/free_arm_motion.py
+++ b/policy/puzzler/free_arm_motion.py
@@ -0,0 +1,275 @@
+"""Screened free-arm motion for wrist-camera looks (official YAM rig).
+
+A free arm can be parked low beside the case: a board brace, a support hand,
+a close look. An unscreened joint-space move from there can sweep its fingers
+through the case wall (29e board_b: Maroon's held look moved the bracing left
+hand straight to its look pose and shoved the case 31 mm and 10.8 deg). Free-arm
+look motions therefore go through this module:
+
+* a TCP below FREE_MOVE_SAFE_Z_M first retreats straight up; a hand that braces
+  the case leaves through the public board-anchor exit (monotone +Z, at most
+  60 mm, its named rim contacts may only open), screened with the rest; when
+  the compliant brace has crept off its recorded pose, by the brace's own
+  measured 60 mm vertical exit (brace_exit);
+* every segment is the native reserved planner's path (Cartesian samples for
+  the retreat, joint interpolation to the look or home) and is screened by the
+  full public robot/scene guard before any motor command: both arms, the
+  table, the 79 case meshes, every piece of the attributed planning scene and,
+  when the other hand holds a part, that part at its holder-FK pose with the
+  holder's declared contact bead (the holder stays still);
+* after the look the arm goes home along a screened joint path, otherwise back
+  along its own screened samples.
+
+A refused plan moves nothing; the caller keeps its non-look path.
+"""
+import json
+
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+from . import vision_controller as c
+from . import modular_red_placement as base
+
+RESERVE = .035
+FREE_MOVE_SAFE_Z_M = .865  # vision_controller's free-move height above the case
+ANCHOR_EXIT_MAX_M = .060   # the public board-anchor exit bound
+RETREAT_MAX_M = .120
+
+
+class FreeArmRefusal(c.PlanningRefusal):
+    """No screened free-arm path; nothing moved."""
+
+
+class _Moved(FreeArmRefusal):
+    """Actual q16 changed between screening and streaming; nothing moved."""
+
+
+def _geometry():
+    from .red_bimanual_goal import geometry
+    return geometry()
+
+
+def held_part(ctx, name, prediction, holder, beads, envelope_m=.008):
+    """The part the other hand holds, as the screen's held body: the
+    prediction's pose relative to the holder's actual TCP (aim and screening
+    only, never a measurement). ``envelope_m`` is its declared bound."""
+    tcp = np.asarray(base.proprio(ctx, holder)['tcp'], float)
+    R = Rotation.from_quat(tcp[3:]).as_matrix(); body = np.asarray(prediction, float)
+    return dict(holder=int(holder), name=name, beads=[int(b) for b in beads],
+                belief=dict(object_in_tcp_position=(R.T @ (body[:3]-tcp[:3])).tolist(),
+                            object_in_tcp_rotation=(R.T @ Rotation.from_quat(body[3:]).as_matrix()).tolist(),
+                            uncertainty_m=float(envelope_m)))
+
+
+def _screen(scene, arm, qpath, *, held=None, target=None, anchor=None):
+    from .red_bimanual_handoff import _failure_summary
+    g = _geometry(); qpath = np.asarray(qpath, float)
+    try:
+        guard, ok = _screen_once(g, scene, arm, qpath, held=held, target=target, anchor=anchor)
+    except FreeArmRefusal:
+        raise
+    except Exception as error:  # geometry query refusal (e.g. anchor contract): nothing moved
+        raise FreeArmRefusal(f'Free-arm screen refused: {type(error).__name__}: {str(error)[:300]}')
+    if not ok:
+        raise FreeArmRefusal('Free-arm full public robot/scene guard refused '
+                             + json.dumps(_failure_summary(guard), separators=(',', ':')))
+    return dict(samples=guard.get('samples_checked', guard.get('dense_samples')), clearance_m=guard.get('clearance_m'))
+
+
+def _screen_once(g, scene, arm, qpath, *, held, target, anchor):
+    """Robot material against everything: both arms, the table, the 79 case
+    meshes, every scene piece and the target. A held part is the target at its
+    holder-FK pose with the holder's declared contact bead; the holder does not
+    move, so the held part's own envelope relative to the scene is unchanged by
+    a free-arm move."""
+    from .red_bimanual_goal import _guard_safe
+    from .vision_planning import finite_fk
+    contract = {}
+    if held is not None:
+        holder = held['holder']; belief = held['belief']; off = 8*holder
+        if np.max(np.abs(qpath[:, off:off+8]-qpath[0, off:off+8])) > 1e-9:
+            raise FreeArmRefusal('A free-arm path must keep the holding arm still')
+        g.fk(qpath[0]); pp, qq = finite_fk(g.robot.iks['left' if holder == 0 else 'right'], qpath[0])
+        R = Rotation.from_quat(qq).as_matrix()
+        pose = np.r_[np.asarray(pp)+R @ np.asarray(belief['object_in_tcp_position']),
+                     Rotation.from_matrix(R @ np.asarray(belief['object_in_tcp_rotation'])).as_quat()]
+        name = held['name']; contract = {holder: list(held['beads'])}
+    else:
+        name, pose = target
+    guard = g.screen_robot_material_path(qpath.tolist(), scene, target=name,
+                                         target_body_poses=np.asarray(pose, float),
+                                         finger_target_contract=contract, board_anchor_exit=anchor)
+    return guard, _guard_safe(guard, scene, material=True)
+
+
+def _segment(q16, joints, arm):
+    from .red_bimanual_handoff import _expand
+    off = 8*arm; q = np.asarray(q16, float)
+    return _expand(q, [q[off:off+6], np.asarray(joints, float)], arm)
+
+
+def _anchor_spec(anchor_evidence, arm):
+    if not anchor_evidence:
+        return None
+    if int(anchor_evidence.get('arm', anchor_evidence.get('arm_id', -1))) != int(arm):
+        return None
+    return dict(arm=int(arm), direction_world=[0., 0., 1.], maximum_distance_m=ANCHOR_EXIT_MAX_M,
+                source_anchor=anchor_evidence)
+
+
+def _default_target(scene, held):
+    if held is not None:
+        return None
+    for name, item in scene.get('occupancy', {}).items():
+        if item.get('pose_hypotheses'):
+            return name, item['pose_hypotheses'][0]
+    raise FreeArmRefusal('Planning scene has no occupancy to screen against')
+
+
+def plan(ctx, arm, joints, *, scene, held=None, target=None, anchor_evidence=None):
+    """Screened path for ``arm`` from its actual encoders to ``joints``.
+
+    Returns dict(arm, segments=[q16 rows,...], retreat=...) with every segment
+    already screened, or raises FreeArmRefusal having moved nothing.
+    """
+    if scene is None or not scene.get('occupancy'):
+        raise FreeArmRefusal('No attributed planning scene to screen a free-arm move')
+    target = target or _default_target(scene, held)
+    actual = base.proprio(ctx, arm)
+    q = np.asarray(actual['robot_encoder_values'], float)
+    tcp = np.asarray(actual['tcp'], float)
+    segments = []; record = dict(arm=int(arm), start_tcp=tcp.tolist(), retreat=None)
+    if tcp[2] < FREE_MOVE_SAFE_Z_M:
+        anchor = _anchor_spec(anchor_evidence, arm)
+        rise = min(ANCHOR_EXIT_MAX_M if anchor else RETREAT_MAX_M, FREE_MOVE_SAFE_Z_M-tcp[2]+.005)
+        rise = max(rise, .02)
+        R = Rotation.from_quat(tcp[3:]).as_matrix()
+        path = ctx.tool('puzzle.plan_pose_sequence', waypoints=[dict(position=(tcp[:3]+[0., 0., rise]).tolist(),
+                        rotation=c.qdict(Rotation.from_matrix(R).as_quat()))], arm_id=arm,
+                        min_joint_limit_margin_rad=RESERVE)
+        if not path.get('feasible') or path.get('min_joint_limit_margin_rad', -1.) < RESERVE:
+            raise FreeArmRefusal('Vertical free-arm retreat native path refused '
+                                 + json.dumps((path.get('errors') or [{}])[-1]))
+        from .red_bimanual_handoff import _expand
+        rows = _expand(q, path['path'], arm)
+        record['retreat'] = dict(rise_m=float(rise), board_anchor_exit=anchor is not None,
+                                 guard=_screen(scene, arm, rows, held=held, target=target, anchor=anchor))
+        segments.append(rows); q = rows[-1]
+    rows = _segment(q, joints, arm)
+    record['move_guard'] = _screen(scene, arm, rows, held=held, target=target)
+    segments.append(rows)
+    return dict(record, segments=[s.tolist() for s in segments], target=target, held=held, scene=scene)
+
+
+def _stream(ctx, arm, rows, *, holder=None):
+    """Stream screened q16 samples at the free-space pace (<= .018 rad per
+    waypoint, 2 control steps each, as vision_controller.feed_joint_plan)."""
+    off = 8*arm; q = np.asarray(rows, float)
+    current = np.asarray(base.proprio(ctx, arm)['robot_encoder_values'], float)
+    if np.max(np.abs(current-q[0])) > .002:
+        raise _Moved('Actual q16 changed since free-arm path screening')
+    start_width = base.proprio(ctx, holder)['width_m'] if holder is not None else None
+    keep = [0]
+    for i in range(1, len(q)):
+        if np.max(np.abs(q[i, off:off+6]-q[keep[-1], off:off+6])) >= .018 or i == len(q)-1:
+            keep.append(i)
+    moved = ctx.tool('robot.execute_trajectory', trajectory=dict(waypoints=[
+        dict(positions=q[i, off:off+6].tolist()) for i in keep[1:]]), arm_id=arm, max_steps_per_waypoint=2)
+    if moved.get('status') != 'ok':
+        raise c.PlanningRefusal('Free-arm motor execution failed')
+    ctx.tool('robot.wait_steps', steps=10)
+    if holder is not None and base.proprio(ctx, holder)['width_m'] < max(.008, start_width-.0025):
+        raise c.PlanningRefusal('Holder jaw contradicted its attachment during the free-arm look')
+    return dict(waypoints=len(keep)-1)
+
+
+def execute(ctx, motion):
+    holder = motion['held']['holder'] if motion.get('held') else None
+    return [_stream(ctx, motion['arm'], rows, holder=holder) for rows in motion['segments']]
+
+
+BRACE_MATCH_M = .010  # a hand this close to its recorded brace TCP is still bracing
+
+
+def _bracing(ctx, arm, anchor_evidence):
+    if not anchor_evidence or int(anchor_evidence.get('arm', anchor_evidence.get('arm_id', -1))) != int(arm):
+        return False
+    source = anchor_evidence.get('actual_TCP', anchor_evidence.get('actual_tcp'))
+    tcp = np.asarray(base.proprio(ctx, arm)['tcp'][:3], float)
+    return source is not None and float(np.linalg.norm(tcp-np.asarray(source, float))) < BRACE_MATCH_M
+
+
+def brace_exit(ctx, arm):
+    """A bracing hand leaves the case rim by the brace's own declared exit
+    (the first step of the support-anchor release): straight up 60 mm along
+    the native Cartesian planner's path, measured. The compliant brace contact
+    creeps, so a pre-screened path from the recorded brace pose cannot start
+    where the hand actually is; every later segment is screened."""
+    actual, q = c.hand(ctx, arm)
+    movement = c.move(ctx, np.asarray(actual)+[0., 0., ANCHOR_EXIT_MAX_M], q, arm, cartesian=True, accuracy=.0025)
+    after, _ = c.hand(ctx, arm)
+    if after[2]-actual[2] < .0575:
+        raise c.PlanningRefusal('Brace withdrawal did not reach its declared vertical clearance')
+    return dict(kind='brace_vertical_exit', initial_tcp=np.asarray(actual).tolist(),
+                withdrawn_tcp=np.asarray(after).tolist(), outcome=movement.get('outcome'))
+
+
+def move_to(ctx, arm, joints, *, scene, held=None, target=None, anchor_evidence=None, attempts=3):
+    """Plan (screened) and execute; returns the motion record. A refusal before
+    any motion raises FreeArmRefusal. A path whose start no longer matches the
+    actual encoders (a settling arm) is re-planned from the actual state,
+    at most ``attempts`` times. A bracing hand first leaves by brace_exit."""
+    exit_record = None
+    if _bracing(ctx, arm, anchor_evidence):
+        # Preferred: the public board-anchor exit, screened with the rest.
+        try:
+            motion = plan(ctx, arm, joints, scene=scene, held=held, target=target, anchor_evidence=anchor_evidence)
+            motion['executions'] = execute(ctx, motion)
+            motion['brace_exit'] = 'screened_board_anchor_exit'; motion['replans'] = 0
+            return motion
+        except _Moved:
+            pass
+        except FreeArmRefusal as error:
+            if 'anchor' not in str(error).lower():
+                raise
+        if _bracing(ctx, arm, anchor_evidence):
+            exit_record = brace_exit(ctx, arm)
+    for attempt in range(attempts):
+        motion = plan(ctx, arm, joints, scene=scene, held=held, target=target)
+        try:
+            motion['executions'] = execute(ctx, motion)
+        except _Moved:
+            if attempt == attempts-1:
+                raise
+            continue
+        motion['brace_exit'] = exit_record; motion['replans'] = attempt
+        return motion
+
+
+def go_home(ctx, motion):
+    """Return the looking arm home along a screened joint path; otherwise back
+    along its own screened samples (the other arm has not moved, so they are the
+    same configurations). Never an unscreened move."""
+    arm = motion['arm']; g = _geometry()
+    home_q = np.asarray(g.robot.iks['left' if arm == 0 else 'right']._home_q, float)
+    q = np.asarray(base.proprio(ctx, arm)['robot_encoder_values'], float)
+    holder = motion['held']['holder'] if motion.get('held') else None
+    try:
+        rows = _segment(q, home_q, arm)
+        guard = _screen(motion['scene'], arm, rows, held=motion.get('held'), target=motion.get('target'))
+        _stream(ctx, arm, rows, holder=holder)
+        return dict(home=True, guard=guard)
+    except FreeArmRefusal as error:
+        refusal = str(error)[:300]
+    back = [np.asarray(s, float)[::-1] for s in motion['segments'][::-1]]
+    back[0] = np.vstack([q, back[0][1:]])
+    for rows in back:
+        _stream(ctx, arm, rows, holder=holder)
+    return dict(home=False, reversed_screened_path=True, home_refusal=refusal)
+
+
+def scene_for(state, observed):
+    """The attributed planning scene for screening a free-arm move made before
+    the stage builds its own: the controller's scene belief from this frame."""
+    from .modular_controller import scene_belief, save_observation
+    return scene_belief(save_observation(state, observed), observed)
diff -ruN '--exclude=__pycache__' clean/policy/puzzler/free_hand_look.py A/policy/puzzler/free_hand_look.py
--- a/policy/puzzler/free_hand_look.py
+++ b/policy/puzzler/free_hand_look.py
@@ -0,0 +1,256 @@
+"""Active wrist-camera look by the free hand at a part the other hand holds.
+
+Official YAM rig: the gantry camera sees a held part partly hidden by the
+holding hand, and the holder's own wrist camera is the only other view, so a
+held part often lacks the two supported views RGB acceptance requires. The
+free hand carries its wrist camera to look at the held part instead.
+
+Look poses are camera geometry around the robot-FK prediction of the held body
+(holder encoders x held attachment). The prediction only aims the camera; it is
+never a measurement. Every look path is the native reserved planner's and is
+screened by the unchanged full public robot/scene guard (held attachment
+envelope, holder's declared contact only, 0.5 mm ordinary clearance).
+"""
+import json
+
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+from . import vision_controller as c
+from . import modular_red_placement as base
+
+RESERVE = .035
+LOOK_DISTANCES_M = (.30,)
+LOOK_ELEVATIONS_DEG = (35., 50.)
+LOOK_AZIMUTHS_DEG = (0., -30., 30.)
+LOOK_MAX_CANDIDATES = 3
+
+
+def body(actual, belief):
+    hand = Rotation.from_quat(actual['tcp'][3:]).as_matrix()
+    return np.r_[np.asarray(actual['tcp'][:3]) + hand @ np.asarray(belief['object_in_tcp_position']),
+                 Rotation.from_matrix(hand @ np.asarray(belief['object_in_tcp_rotation'])).as_quat()]
+
+
+def look_waypoints(looking_arm, center):
+    """TCP waypoints that put the looking arm's wrist camera on ``center``."""
+    from .red_bimanual_handoff import geometry, _waypoint
+    from .survey import look_at, LOOK_TARGET_UV, _K
+    from .vision import wrist_mount
+    ik = geometry().robot.iks['left' if looking_arm == 0 else 'right']
+    offset = np.eye(4)
+    offset[:3, :3] = Rotation.from_quat(np.asarray(ik.ee_offset_rot, float)).as_matrix()
+    offset[:3, 3] = np.asarray(ik.ee_offset, float)
+    # Fingertips fill the lower image: tilt so the target sits at LOOK_TARGET_UV.
+    K = _K()
+    tilt = Rotation.from_euler('x', -float(np.arctan2(K[1, 2] - LOOK_TARGET_UV[1], K[1, 1]))).as_matrix()
+    outward = np.array([0., 1. if looking_arm == 0 else -1., 0.])
+    for elevation in LOOK_ELEVATIONS_DEG:
+        for azimuth in LOOK_AZIMUTHS_DEG:
+            for distance in LOOK_DISTANCES_M:
+                horizontal = Rotation.from_euler('z', azimuth, degrees=True).apply(outward)
+                e = np.radians(elevation)
+                direction = np.cos(e) * horizontal + np.sin(e) * np.array([0., 0., 1.])
+                camera = look_at(np.asarray(center) + distance * direction, center, (0., 0., 1.))
+                camera[:3, :3] = camera[:3, :3] @ tilt
+                tcp = camera @ np.linalg.inv(wrist_mount()) @ offset
+                yield (dict(elevation_deg=elevation, azimuth_deg=azimuth, distance_m=distance),
+                       _waypoint(tcp[:3, 3], tcp[:3, :3]))
+
+
+def _screened(ctx, scene, belief, name, held_arm, moving_arm, qpath, contract):
+    from .red_bimanual_handoff import geometry, _guard_passes, _failure_summary, _held_envelope
+    from .vision_planning import finite_fk
+    g = geometry()
+    g.fk(qpath[0])
+    pp, qq = finite_fk(g.robot.iks['left' if held_arm == 0 else 'right'], qpath[0])
+    held_pose = body(dict(tcp=[*np.asarray(pp).tolist(), *np.asarray(qq).tolist()]), belief)
+    guard = g.screen_q16_path(qpath, scene=scene, moving_arm=moving_arm, held_arm=held_arm,
+                              held_body_pose=held_pose.tolist(),
+                              object_in_tcp_position=belief['object_in_tcp_position'],
+                              object_in_tcp_rotation=belief['object_in_tcp_rotation'], target=name,
+                              finger_target_contract=contract, board_anchor_exit=None,
+                              held_envelope_m=_held_envelope(belief))
+    if not _guard_passes(guard, scene):
+        raise c.PlanningRefusal('Free-hand look full public robot/scene guard refused '
+                                + json.dumps(_failure_summary(guard), separators=(',', ':')))
+    return guard
+
+
+def _stream(ctx, motion, holder):
+    """Stream a screened q16 path at the free-space look pace (<= .018 rad per
+    waypoint, 2 control steps each, as vision_controller.feed_joint_plan),
+    through the same screened joint samples; holder jaw retention is checked."""
+    arm = motion['arm']; off = 8 * arm
+    q = np.asarray(motion['q16_path'], float)
+    current = base.proprio(ctx, arm)
+    if np.max(np.abs(np.asarray(current['robot_encoder_values']) - q[0])) > .002:
+        raise c.PlanningRefusal('Actual q16 changed since free-hand look path screening')
+    start_width = base.proprio(ctx, holder)['width_m']
+    keep = [0]
+    for i in range(1, len(q)):
+        if np.max(np.abs(q[i, off:off + 6] - q[keep[-1], off:off + 6])) >= .018 or i == len(q) - 1:
+            keep.append(i)
+    moved = ctx.tool('robot.execute_trajectory', trajectory=dict(waypoints=[
+        dict(positions=q[i, off:off + 6].tolist()) for i in keep[1:]]), arm_id=arm, max_steps_per_waypoint=2)
+    if moved.get('status') != 'ok':
+        raise c.PlanningRefusal('Free-hand look motor execution failed')
+    ctx.tool('robot.wait_steps', steps=10)
+    if base.proprio(ctx, holder)['width_m'] < max(.008, start_width - .0025):
+        raise c.PlanningRefusal('Holder jaw contradicted its attachment during the free-hand look')
+    return dict(waypoints=len(keep) - 1, actual_after=base.proprio(ctx, arm))
+
+
+CASE_CLEAR_OF_FINGERS_V = 480.  # the fingertips fill the image below this row
+
+
+def _survey_candidates(looker, center, board_pose, frame_case=True):
+    """Precomputed survey looks of the looking arm that frame the held part
+    above the fingertips and, with ``frame_case``, keep every case corner out
+    of the fingertip band so the case outline can be fitted in this view (aim
+    from the robot-FK prediction and the dated RGB case pose; never measured)."""
+    from .survey import looks, _K
+    from .vision import D405
+    K = _K(); side = 'left' if looker == 0 else 'right'
+    board = np.asarray(board_pose, float)
+    rotation = Rotation.from_quat(board[3:])
+    corners = rotation.apply([[.0275 + sx * .110, sy * .1575, .013] for sx in (-1, 1) for sy in (-1, 1)]) + board[:3]
+    rows = []
+    for index, row in enumerate(looks()[side]['looks']):
+        C = np.asarray(row['camera_to_world'])
+        local = (np.asarray(center, float) - C[:3, 3]) @ C[:3, :3]
+        if local[2] <= .10:
+            continue
+        u, v = (K @ local)[:2] / local[2]
+        if not (60 <= u <= D405['width'] - 60 and 40 <= v <= 520):
+            continue
+        if frame_case:
+            local = (corners - C[:3, 3]) @ C[:3, :3]
+            if np.any(local[:, 2] <= .10) or np.any((local @ K.T)[:, 1] / local[:, 2] > CASE_CLEAR_OF_FINGERS_V):
+                continue
+        rows.append((index, list(row['joints'])))
+    return rows
+
+
+def _plan_joints(ctx, scene, belief, name, held_arm, moving_arm, joints, contract):
+    from .red_bimanual_handoff import _expand, _waypoint, geometry
+    from .vision_planning import finite_fk
+    actual = base.proprio(ctx, moving_arm)
+    off = 8 * moving_arm
+    q = np.asarray(actual['robot_encoder_values'], float)
+    qpath = _expand(q, [q[off:off + 6], np.asarray(joints, float)], moving_arm)
+    guard = _screened(ctx, scene, belief, name, held_arm, moving_arm, qpath, contract)
+    g = geometry(); g.fk(qpath[-1])
+    pp, qq = finite_fk(g.robot.iks['left' if moving_arm == 0 else 'right'], qpath[-1])
+    return dict(arm=moving_arm, q16_path=qpath.tolist(), guard=guard, source_actual=actual,
+                endpoint=_waypoint(np.asarray(pp), Rotation.from_quat(qq).as_matrix()))
+
+
+def look(ctx, *, name, holder, looker, belief, scene, holder_beads, hints, return_home=False, frame_case=True,
+         exclude_looks=(), alias_authority=True):
+    """Look at the held part with the free hand's wrist camera; returns (observation, record).
+
+    Preferred: a precomputed survey look that frames both the held part and the
+    case, so the same frame can also reacquire the case with the gantry view.
+    Fallback: a look generated around the held part. Least joint travel first.
+    The free hand must be open. With ``return_home`` it goes back to where it
+    started along a screened path after the frame. A refused plan returns
+    (None, record) and moves nothing. ``exclude_looks``: look labels whose
+    frame already failed to accept the part in this refresh; another view is
