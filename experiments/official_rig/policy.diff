+def textured_assets(appearance,seed,manifest):
+    """Scene only: per-piece visual meshes with UVs and procedural diffuse maps.
+
+    The colliders are the manifest's unchanged ones; only the drawn mesh gains
+    texture coordinates (planar, in the piece's own metres, a 150 mm map), and
+    a diffuse PNG. Written once under ROOT/scene_textures/<appearance>-<seed>/.
+    The policy never receives the appearance or these files' names.
+    """
+    import trimesh
+    from PIL import Image
+    folder=m.ROOT/'scene_textures'/f'{appearance}-{seed}'
+    folder.mkdir(parents=True,exist_ok=True)
+    out={}
+    for name in m.CELLS:
+        mesh_path=folder/f'{name}.obj';png=folder/f'{name}.png'
+        if not mesh_path.exists() or not png.exists():
+            mesh=trimesh.load(manifest[name]['path'],force='mesh',process=False)
+            p=np.asarray(mesh.vertices)
+            uv=np.c_[(p[:,0]-p[:,0].min())/.15,(p[:,1]-p[:,1].min()+.5*(p[:,2]-p[:,2].min()))/.15]
+            linear=_texture_image(appearance,name,seed)
