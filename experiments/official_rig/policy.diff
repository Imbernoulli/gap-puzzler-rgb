+    LA = np.concatenate(local_starts); LB = np.concatenate(local_ends)
+    axis = B-A; length2 = np.maximum(np.sum(axis**2, axis=1), 1.e-12)
+    p = polygon; q = np.roll(polygon, -1, axis=0)
+    fp = np.clip(((p[:, None]-A[None])*axis[None]).sum(2)/length2, 0, 1)
+    fq = np.clip(((q[:, None]-A[None])*axis[None]).sum(2)/length2, 0, 1)
+    dp = np.linalg.norm(A[None]+fp[..., None]*axis[None]-p[:, None], axis=2)
+    dq = np.linalg.norm(A[None]+fq[..., None]*axis[None]-q[:, None], axis=2)
+    j = np.argmin(dp+dq, axis=1); rows = np.arange(len(p))
+    source = np.stack([LA[j]+fp[rows, j, None]*(LB[j]-LA[j]), LA[j]+fq[rows, j, None]*(LB[j]-LA[j])], axis=1)
+    return polygon, source
+
+
+def _case_side(local):
+    """Physical outer side of case-local points: 0 rim x-, 1 lid/hinge x+, 2 y-, 3 y+, -1 none."""
+    side = np.full(len(local), -1)
+    side[local[:, 0] <= -.0825+.0006] = 0
+    side[local[:, 0] >= .0815] = 1
+    side[local[:, 1] <= -.1575+.0006] = 2
+    side[local[:, 1] >= .1575-.0006] = 3
+    return side
+
+
+def _case_edge_samples(rgb, camera):
+    """Sub-pixel case/background boundary samples (midpoints of 4-neighbour pairs)."""
+    image = np.asarray(rgb)[..., :3].astype(np.int16)
+    high = image.max(axis=2); spread = high-image.min(axis=2)
+    dark = high < CASE_DARK_MAX
+    background = (~dark) & (spread <= CASE_NEUTRAL_SPREAD)
+    occluder = getattr(camera, 'occluder', None)
+    blocked = np.zeros(dark.shape, bool) if occluder is None else np.asarray(occluder).astype(bool)
+    if blocked.shape != dark.shape:
+        blocked = np.zeros(dark.shape, bool)
+    pair = ((dark[:, :-1] & background[:, 1:]) | (background[:, :-1] & dark[:, 1:])) & ~(blocked[:, :-1] | blocked[:, 1:])
+    ys, xs = np.nonzero(pair); horizontal = np.c_[xs+.5, ys]
+    pair = ((dark[:-1] & background[1:]) | (background[:-1] & dark[1:])) & ~(blocked[:-1] | blocked[1:])
+    ys, xs = np.nonzero(pair); vertical = np.c_[xs, ys+.5]
+    points = np.concatenate([horizontal, vertical]).astype(float)
+    h, w = dark.shape
+    keep = (points[:, 0] > 1.5) & (points[:, 0] < w-2.5) & (points[:, 1] > 1.5) & (points[:, 1] < h-2.5)
+    return points[keep]
+
+
+def _outline_distance(points, polygon):
+    axis = np.roll(polygon, -1, axis=0)-polygon
+    length2 = np.maximum(np.sum(axis**2, axis=1), 1.e-12)
+    fraction = np.clip(((points[:, None]-polygon[None])*axis[None]).sum(2)/length2, 0, 1)
+    distance = np.linalg.norm(points[:, None]-polygon[None]-fraction[..., None]*axis[None], axis=2)
+    nearest = distance.argmin(axis=1); rows = np.arange(len(points))
+    return distance[rows, nearest], nearest, fraction[rows, nearest]
+
+
+def _band(points, camera, x, width, limit=1500):
+    silhouette = _case_silhouette(camera, x, source=False)
+    if silhouette is None or not len(points):
+        return np.empty((0, 2))
+    selected = points[_outline_distance(points, silhouette[0])[0] < width]
+    if len(selected) > limit:
+        selected = selected[np.linspace(0, len(selected)-1, limit).astype(int)]
+    return selected
+
+
+EDGE_DEAD_ZONE_PX = .35     # hard-edge rasterization: true outline within 0.5 px of a sample
+
+
+def _edge_fit(samples, cameras, x0, bands=(14., 6., 3.)):
+    """Joint robust image-plane fit; samples re-selected in shrinking bands.
+
+    The renderer's case edges are hard (no anti-aliasing): a dark/background
+    pixel pair only says the outline passes between the two pixel centres, so
+    it lies within 0.5 px of the pair midpoint. Least squares to midpoints is
+    biased where an edge runs along a pixel row (the case at yaw ~0 in the
+    gantry view, up to 0.65 mm); the final stage therefore treats each sample
+    as an interval, penalising only distances beyond 0.35 px.
+    """
+    x = np.asarray(x0, float).copy()
+
+    def residual(xx, subset, dead=0.):
+        out = []
+        for key, points in subset.items():
+            silhouette = _case_silhouette(cameras[key], xx, source=False)
+            out.append(np.full(len(points), 50.) if silhouette is None else _outline_distance(points, silhouette[0])[0])
+        out = np.concatenate(out)
+        return np.maximum(out-dead, 0.) if dead else out
+    subset = {}
+    for width, dead in [(width, 0.) for width in bands]+[(bands[-1], EDGE_DEAD_ZONE_PX)]:
+        subset = {key: band for key, points in samples.items()
+                  for band in [_band(points, cameras[key], x, width)] if len(band) >= 20}
+        if not subset:
+            return None
+        fit = least_squares(lambda xx: residual(xx, subset, dead), x, loss='soft_l1', f_scale=.6,
+                            x_scale=np.array([.001, .001, .003]), diff_step=np.array([2.e-5, 2.e-5, 5.e-5]),
+                            max_nfev=60, xtol=1.e-10, ftol=1.e-10)
+        x = fit.x
+    return x
+
+
+def _edge_view_diagnostic(points, camera, x):
+    """Per-view support at pose x: residual, physical side spans, coverage, Jacobian."""
+    silhouette = _case_silhouette(camera, x)
+    if silhouette is None:
+        return dict(usable=False, reason='case CAD behind this camera')
+    polygon, source = silhouette
+    band = _band(points, camera, x, 6., limit=4000)
+    if len(band) < EDGE_MIN_INLIERS:
+        return dict(usable=False, reason='too few case/background edge samples near the outline', samples=int(len(band)))
+    distance, nearest, fraction = _outline_distance(band, polygon)
+    local = source[nearest, 0]+fraction[:, None]*(source[nearest, 1]-source[nearest, 0])
+    side = _case_side(local)
+    inlier = distance < EDGE_INLIER_PX
+    along = [local[inlier & (side == s), 1 if s < 2 else 0] for s in range(4)]
+    spans = [_covered_length(values) for values in along]
+    # Coverage: visible predicted outline (inside the image, off the robot)
+    # that has an edge sample within the inlier distance.
+    h, w = (int(round(2*camera.K[1, 2])), int(round(2*camera.K[0, 2])))
+    segment = np.roll(polygon, -1, axis=0)-polygon
+    count = np.maximum(1, np.ceil(np.linalg.norm(segment, axis=1)/2.).astype(int))
+    probe = np.concatenate([polygon[k]+np.linspace(0, 1, n, endpoint=False)[:, None]*segment[k]
+                            for k, n in enumerate(count)])
+    inside = (probe[:, 0] > 3) & (probe[:, 0] < w-4) & (probe[:, 1] > 3) & (probe[:, 1] < h-4)
+    occluder = getattr(camera, 'occluder', None)
+    if occluder is not None and inside.any():
+        ij = np.round(probe[inside]).astype(int)
+        hidden = np.zeros(len(probe), bool); hidden[np.flatnonzero(inside)] = np.asarray(occluder)[ij[:, 1], ij[:, 0]] > 0
+        inside &= ~hidden
+    coverage = 0.
+    if inside.sum() >= 10 and inlier.sum() >= 3:
+        from scipy.spatial import cKDTree
+        near, _ = cKDTree(band[inlier]).query(probe[inside], distance_upper_bound=EDGE_INLIER_PX)
+        coverage = float(np.mean(np.isfinite(near)))
+    # Image-plane Jacobian of the inlier distances (outline normal . d pixel / d pose).
+    rows = np.flatnonzero(inlier)
+    normal = segment[nearest[rows]]; normal = np.c_[-normal[:, 1], normal[:, 0]]
+    normal /= np.maximum(np.linalg.norm(normal, axis=1, keepdims=True), 1.e-12)
+    jac = np.zeros((len(rows), 3))
+    base = camera.project(local[rows]@_yaw_matrix(x[2]).T+np.r_[x[0], x[1], CASE_Z])
+    for k, step in enumerate((1.e-5, 1.e-5, 3.e-5)):
+        xx = np.array(x, float); xx[k] += step
+        moved = camera.project(local[rows]@_yaw_matrix(xx[2]).T+np.r_[xx[0], xx[1], CASE_Z])
+        jac[:, k] = np.sum((moved-base)*normal, axis=1)/step
+    return dict(usable=True, samples=int(len(band)), inliers=int(inlier.sum()),
+                median_px=float(np.median(distance)), rms_inlier_px=float(np.sqrt(np.mean(distance[inlier]**2))) if inlier.any() else None,
+                edge_support_m=spans, outline_coverage=coverage, along=along, jacobian=jac)
+
+
+def _covered_length(values, bin_m=.005):
+    """Longest contiguous physical stretch of a side covered by supporting samples.
+
+    5 mm bins, one empty bin tolerated. Unlike a min-max span, patches at the
+    two corners of a side never count as support for the hidden side between.
+    """
+    values = np.asarray(values, dtype=float)
+    if not len(values):
+        return 0.
+    bins = np.unique(np.floor(values/bin_m).astype(int))
+    best = run = 1
+    for gap in np.diff(bins):
+        run = run+int(gap) if gap <= 2 else 1
+        best = max(best, run)
+    return float(bin_m*best)
+
+
+def _corner_sigma(jacobians, x, sigma_px):
+    """Largest predicted 1-sigma case-corner error from the stacked fit Jacobian."""
+    J = np.concatenate(jacobians) if jacobians else np.zeros((0, 3))
+    if len(J) < 3:
+        return float('inf')
+    info = J.T@J/sigma_px**2
+    if np.linalg.cond(info) > 1.e12:
+        return float('inf')
+    covariance = np.linalg.inv(info)
+    c, s = math.cos(x[2]), math.sin(x[2]); worst = 0.
+    for lx, ly in _CASE_CORNERS:
+        # d(corner)/d(x, y, yaw)
+        Jc = np.array([[1., 0., -s*lx-c*ly], [0., 1., c*lx-s*ly]])
+        worst = max(worst, float(np.sqrt(np.linalg.eigvalsh(Jc@covariance@Jc.T).max())))
+    return worst
+
+
+def _two_sided(spans):
+    supported = [s >= EDGE_SIDE_SPAN_M for s in spans]
+    return (supported[0] or supported[1]) and (supported[2] or supported[3])
+
+
+def _pose7(x):
+    return [float(x[0]), float(x[1]), CASE_Z, 0., 0., math.sin(float(x[2])/2), math.cos(float(x[2])/2)]
+
+
+def _corner_points(x):
+    c, s = math.cos(x[2]), math.sin(x[2])
+    return _CASE_CORNERS@np.array([[c, s], [-s, c]])+np.asarray(x[:2])
+
+
+def _assess_edge_fit(samples, cameras, x):
+    views = {key: _edge_view_diagnostic(points, cameras[key], x) for key, points in samples.items()}
+    adopted = {}
+    for key, view in views.items():
+        if not view.get('usable'):
+            continue
+        reasons = []
+        if view['inliers'] < EDGE_MIN_INLIERS: reasons.append('too few supporting edge samples')
+        if view['median_px'] > EDGE_MEDIAN_GATE_PX: reasons.append('edge samples inconsistent with CAD outline')
+        if view['outline_coverage'] < EDGE_COVERAGE_GATE: reasons.append('visible CAD outline lacks image edges')
+        view['adopted'] = not reasons; view['reason'] = '; '.join(reasons)
+        if not reasons:
+            adopted[key] = view
+    along = [np.concatenate([v['along'][s] for v in adopted.values()]) if adopted else np.empty(0) for s in range(4)]
+    spans = [_covered_length(a) for a in along]
+    rms = [v['rms_inlier_px'] for v in adopted.values() if v['rms_inlier_px'] is not None]
+    sigma_px = max(.29, float(np.sqrt(np.mean(np.square(rms)))) if rms else .29)
+    sigma = _corner_sigma([v['jacobian'] for v in adopted.values()], x, sigma_px)
+    return views, adopted, spans, sigma
+
+
+def _public_view(view):
+    return {k: v for k, v in view.items() if k not in ('along', 'jacobian')}
+
+
+def fit_case_views(images, cameras, proposal, keys=None):
+    """Case pose from every current calibrated view that sees it, in one fit.
+
+    ``proposal`` (x, y, yaw) only seeds the optimizer. Accepted only when the
+    adopted views (each: >=40 supporting samples, median <=0.6 px, >=50% of its
+    visible unmasked outline explained) jointly support two non-parallel
+    physical CAD sides by >=35 mm, the predicted corner 1-sigma is <=0.4 mm,
+    every view that alone constrains the pose agrees within 1.5 mm, and no
+    displaced start converges to a different, equally supported pose.
+    """
+    keys = [k for k in (keys or images) if k in images and k in cameras]
+    proposal = np.asarray(proposal, float)
+    samples = {k: _case_edge_samples(images[k], cameras[k]) for k in keys}
+    samples = {k: v for k, v in samples.items() if len(v) >= EDGE_MIN_INLIERS}
+    if not samples:
+        return dict(visible=False, reason='no case/background edges in any view')
+    dropped = {}
+    for _ in range(3):
+        x = _edge_fit(samples, cameras, proposal)
+        if x is None:
+            return dict(visible=False, reason='no view has case edges near the proposal', dropped_views=dropped)
+        views, adopted, spans, sigma = _assess_edge_fit(samples, cameras, x)
+        rejected = [k for k, v in views.items() if v.get('usable') and not v.get('adopted')]
+        if not rejected or not adopted:
+            break
+        # A view whose edges contradict the joint pose is not evidence for it.
+        for k in rejected:
+            dropped[k] = _public_view(views[k]); samples.pop(k)
+    diagnostic = dict(edge_support_m=spans, corner_sigma_m=sigma, adopted_views=sorted(adopted),
+                      view_diagnostics={k: _public_view(v) for k, v in views.items()}, dropped_views=dropped)
+    if not adopted:
+        return dict(visible=False, reason='no view passes the case edge gates', **diagnostic)
+    if not _two_sided(spans):
+        return dict(visible=False, reason='case outline lacks two supported non-parallel sides', **diagnostic)
+    if sigma > CORNER_SIGMA_GATE_M:
+        return dict(visible=False, reason='case pose poorly constrained by the supported edges', **diagnostic)
+    # Independently constrained views must agree (the original two-view rule).
+    alone = {}
+    if len(adopted) >= 2:
+        for k in adopted:
+            if not _two_sided(adopted[k]['edge_support_m']):
