+"""Bounded recovery when an owned RGB source outlives its declared age scope.
+
+The native simulator keeps stepping while the policy computes. On a slow or
+contended host a planning pass (e.g. a widened grasp search) can therefore age
+an owned source past its declared scope although nothing in the scene changed:
+the pregrasp RGB source of a conditional attachment (<= 20 s at close), the
+attachment itself (<= 30 s after close), a measured held source (<= 30 s) or
+the historical RGB reference of a release (<= ``historical_max_age_s``).
+
+Such a refusal says nothing about the scene; a fresh look does. Every limit and
+gate stays unchanged: a new RGB packet is taken now (with a free-wrist look
+where the view needs one, the holding hand still), it must reproduce the dated
+source or measure the held part, and only then is the same owned-source tool
+called on it. Fresh evidence that fails a gate refuses exactly as before.
+"""
+from copy import deepcopy
+
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+from . import vision_controller as c
+from .vision_stages import StageRefusal
+
+# Refresh a planned pregrasp source older than this before the grasp motion
+# starts; the attachment's own 20 s scope is untouched.
+REFRESH_BEFORE_GRASP_S = 8.
+# A fresh fit must reproduce the dated source the plan was computed from.
+SOURCE_MATCH_M = .002
+# Fresh-look attempts per step.
+MAX_ATTEMPTS = 2
+AGE_SCOPE_TEXTS = ('outside declared scope', 'Conditional attachment expired', 'bounded30s',
+                   'exceeds bounded age scope')
+
+
+def is_age_scope_refusal(error):
+    text = str(error)
+    return any(key in text for key in AGE_SCOPE_TEXTS)
+
+
+def _now(ctx, arm):
+    return float(ctx.tool('robot.read_proprioception', arm_id=arm)['timestamp'])
+
+
+def _displacement(name, a, b):
+    from .visual_memory import shape_displacement
+    return float(shape_displacement(name, a, b))
+
+
+def _fresh_loose(ctx, name, pose, *, look, state=None):
+    """A new accepted RGB packet of a loose part, with one free-wrist look if needed."""
+    fresh = c.state(ctx, {name: list(pose)})
+    looks = None
+    if name not in fresh.get('poses', {}) and look:
+        from .survey import look_and_observe
+        from .free_arm_motion import scene_for
+        fresh = look_and_observe(ctx, [name], hints={name: list(pose)}, max_looks=1, always=False,
+                                 scene_fn=(lambda frame: scene_for(state, frame)) if state is not None else None)
+        looks = fresh.get('wrist_looks')
+    return fresh, looks
+
+
+def refresh_planned_source(ctx, state, arm):
+    """Before the grasp motion: replace an aged planned source by a fresh packet
+    that reproduces it (<= SOURCE_MATCH_M). Otherwise keep the dated source
+    unchanged (the original behaviour) and record why."""
+    from .modular_controller import save_observation
+    name = state['piece']; origin = state['observation']
+    age = _now(ctx, arm)-float(origin['timestamp'])
+    record = dict(kind='planned_source_age_refresh', piece=name, dated_source_timestamp=origin['timestamp'],
+                  dated_source_age_s=age, refresh_after_s=REFRESH_BEFORE_GRASP_S, match_limit_m=SOURCE_MATCH_M)
+    if age <= REFRESH_BEFORE_GRASP_S:
+        return state, {**record, 'refreshed': False}
+    pose = origin['poses'][name]
+    for attempt in range(MAX_ATTEMPTS):
+        fresh, looks = _fresh_loose(ctx, name, pose, look=attempt == 0, state=state)
+        record.setdefault('attempts', []).append(dict(timestamp=fresh.get('timestamp'), measured=name in fresh.get('poses', {}),
+                                                      wrist_looks=looks))
+        if name not in fresh.get('poses', {}):
+            continue
+        moved = _displacement(name, pose, fresh['poses'][name])
+        record['attempts'][-1]['displacement_from_dated_source_m'] = moved
+        if moved > SOURCE_MATCH_M:
+            # The part is not where the plan saw it: never re-date the plan.
+            return state, {**record, 'refreshed': False, 'refused': 'fresh RGB does not reproduce the dated source'}
+        state = save_observation(state, fresh)
+        return state, {**record, 'refreshed': True, 'fresh_source_timestamp': fresh['timestamp']}
+    return state, {**record, 'refreshed': False, 'refused': 'fresh RGB does not measure the part'}
+
+
+def reauthenticate_attachment(ctx, state, arm, assumption, error):
+    """After the close, before the lift: an attachment refused only for its source
+    age is captured again from a fresh packet of the closed-jaw part (holder
+    still; the free wrist looks if the frame lacks support). The fresh pose
+    must lie within the attachment's own declared displacement bound of the
+    dated source. Returns (state, attachment or None, record)."""
+    from .modular_controller import save_observation
+    from .survey import look_at_held
+    name = state['piece']
+    record = dict(kind='attachment_source_age_reauthentication', piece=name, original_refusal=str(error))
+    if not is_age_scope_refusal(error):
+        return state, None, {**record, 'skipped': 'refusal is not an age scope'}
+    dated = state['observation']['poses'][name]
+    bound = float(assumption.get('bead_displacement_bound_m', .008))
+    for attempt in range(MAX_ATTEMPTS):
+        fresh = c.state(ctx, {name: list(dated)}); look = None
+        if name not in fresh.get('poses', {}):
+            fresh, look = look_at_held(ctx, name, np.asarray(dated, float), arm, reference=fresh, **_held_look_scope(state, bound))
+        row = dict(timestamp=fresh.get('timestamp'), measured=name in fresh.get('poses', {}), free_wrist_look=look)
+        record.setdefault('attempts', []).append(row)
+        if name not in fresh.get('poses', {}):
+            continue
+        row['displacement_from_dated_source_m'] = moved = _displacement(name, dated, fresh['poses'][name])
+        if moved > bound:
+            return state, None, {**record, 'refused': 'fresh closed-jaw RGB exceeds the declared attachment bound'}
+        state = save_observation(state, fresh)
+        source = dict(piece=name, pose=fresh['poses'][name], timestamp=fresh['timestamp'], frame_sha256=fresh['frame_sha256'],
+                      observation_source=fresh['observation_source'],
+                      role='Actual closed-jaw pre-lift RGB (age-scope reauthentication); not a postlift held measurement')
+        try:
+            attachment = ctx.tool('puzzle.capture_conditional_attachment', source_rgb=source, assumption=assumption, arm_id=arm)
+        except ValueError as second:
+            row['capture_refusal'] = str(second)
+            if not is_age_scope_refusal(second):
+                return state, None, record
+            continue
+        return state, attachment, {**record, 'reauthenticated': True, 'attachment_id': attachment['attachment_id']}
+    return state, None, record
+
+
+def _held_prediction(ctx, state, arm):
+    """Aim point for a free-wrist look at the held part: current FK x the owned
+    relative transform (aim only, never a measurement)."""
+    p = state['parameters']; name = state['piece']
+    tcp = ctx.tool('robot.read_proprioception', arm_id=arm)['tcp']
+    R = Rotation.from_quat(tcp[3:]).as_matrix()
+    attachment = state.get('conditional_attachment') or {}
+    if 'object_in_tcp_position' in attachment:
+        rel_p = np.asarray(attachment['object_in_tcp_position'], float); rel_R = np.asarray(attachment['object_in_tcp_rotation'], float)
+        return np.r_[np.asarray(tcp[:3]) + R@rel_p, Rotation.from_matrix(R@rel_R).as_quat()]
+    source = p.get('owned_held_belief_source') or {}
+    if 'pose' in source:
+        return np.asarray(source['pose'], float)
+    return np.asarray(state.get('prediction') or state['plan']['body'], float)
+
+
+def owned_held_belief(ctx, state, refresh_after_s=None):
+    """Propagate the owned held estimate. When only its age scope refuses it,
+    measure the held part now with the free wrist camera (holder still) and
+    continue from that accepted current RGB/q16 source. With
+    ``refresh_after_s`` (carry start, where the held part is still clear of the
+    case) a valid estimate older than that is renewed the same way, keeping
+    the valid one if the look does not measure the part. Returns (state, belief, record)."""
+    from .modular_controller import save_observation
+    from .survey import look_at_held
+    p = state['parameters']; arm = state['arm']; name = state['piece']
+    try:
+        if p.get('conditional_attachment_id'):
+            belief = ctx.tool('puzzle.propagate_conditional_attachment', attachment_id=p['conditional_attachment_id'], arm_id=arm)
+        else:
+            belief = ctx.tool('puzzle.propagate_pyramid_held_belief', source=p['owned_held_belief_source'], arm_id=arm)
+        if refresh_after_s is None or float(belief.get('source_age_s', 0.)) <= refresh_after_s:
+            return state, belief, None
+        valid = belief
+        record = dict(kind='held_source_age_renewal', piece=name, source_age_s=float(belief['source_age_s']),
+                      renew_after_s=refresh_after_s)
+    except ValueError as error:
+        if not is_age_scope_refusal(error):
+            raise
+        valid = None
+        record = dict(kind='held_source_age_remeasurement', piece=name, original_refusal=str(error))
+    looked = False
+    for attempt in range(MAX_ATTEMPTS):
+        prediction = _held_prediction(ctx, state, arm)
+        fresh = c.state(ctx, {name: prediction.tolist()}); look = None
+        if name not in fresh.get('poses', {}) and not looked:
+            fresh, look = look_at_held(ctx, name, prediction, arm, reference=fresh, **_held_look_scope(state))
+            # A look that moved the free arm and still did not measure the part
+            # is not repeated from the same view (v14: a refused renewal look
+            # cost two attempts, ~23 s, on Azure in 29h).
+            looked = bool(look) and not look.get('refused') and not look.get('measured_before_look')
+        row = dict(timestamp=fresh.get('timestamp'), measured=name in fresh.get('poses', {}), free_wrist_look=look)
+        record.setdefault('attempts', []).append(row)
+        if name not in fresh.get('poses', {}):
+            if looked and valid is not None:
+                break  # renewal: keep the valid estimate, back to the existing path
+            continue
+        tcp, _ = c.hand(ctx, arm)
+        gap = c.part_hand_gap(name, fresh['poses'][name], tcp); row['hand_bead_gap_m'] = gap
+        if gap > .045:
+            raise StageRefusal('Current RGB contradicts the retained grasp (held part away from the hand)')
+        q16 = fresh['robot_geometry_provenance']
+        source = dict(mode='pyramid', piece=name, pose=fresh['poses'][name], timestamp=fresh['timestamp'], frame_sha256=fresh['frame_sha256'],
+                      observation_source=fresh['observation_source'], robot_encoder_values=q16['robot_encoder_values'],
+                      robot_encoder_sha256=q16['robot_encoder_sha256'], source_step=q16['step'],
+                      source_role='Actual accepted current held RGB and synchronous robot q16 (age-scope remeasurement)')
+        p = {**p, 'owned_held_belief_source': source}; p.pop('conditional_attachment_id', None)
+        state = {**save_observation(state, fresh), 'parameters': p}
+        belief = ctx.tool('puzzle.propagate_pyramid_held_belief', source=source, arm_id=arm)
+        return state, belief, {**record, 'remeasured': True, 'source_timestamp': source['timestamp']}
+    if valid is not None:
+        return state, valid, {**record, 'renewed': False}
+    raise StageRefusal('Held estimate outlived its declared age scope and a fresh look did not measure the held part: '
+                       + str(record['original_refusal']))
+
+
+def refresh_historical_reference(ctx, state):
+    """Release planning: when the grasp-time historical RGB reference has used
+    two thirds of its age limit, the newest owned accepted packet that has the
+    case becomes the reference (same limit); the record list is the current
+    RGB history. A fresh host never reaches this."""
+    p = state['parameters']; history = state.get('rgb_history', [])
+    old = p.get('historical_complete_rgb')
+    if old is None:
+        return state, None
+    limit = float(p.get('historical_max_age_s', 15.))
+    if _now(ctx, state['arm'])-float(old.get('timestamp', 0.)) <= 2*limit/3:
+        return state, None
+    # Newest by time, not by list position (a stage may re-save an older packet).
+    newest = max((row for row in history if 'board' in row.get('poses', {})), key=lambda row: float(row['timestamp']), default=None)
+    if newest is None or float(newest['timestamp']) <= float(old.get('timestamp', -1.)):
+        return state, None
+    p = {**p, 'historical_complete_rgb': {k: deepcopy(newest[k]) for k in ('poses', 'timestamp', 'frame_sha256', 'observation_source') if k in newest},
+         'historical_rgb_records': deepcopy(history)}
+    return {**state, 'parameters': p}, dict(kind='historical_reference_refresh', previous_timestamp=old.get('timestamp'),
+                                            reference_timestamp=newest['timestamp'])
+
+
+def refresh_stale_observation(ctx, state, limit_s=30.):
+    """Carry planning: when the last accepted packet has used two thirds of the
+    carry's board-source limit, take a fresh one (held part seeded by its owned
+    prediction) so the carry is planned from current RGB."""
+    from .modular_controller import save_observation
+    arm = state['arm']; name = state['piece']
+    age = _now(ctx, arm)-float(state['observation']['timestamp'])
+    if age <= 2*limit_s/3:
+        return state, None
+    hints = {name: _held_prediction(ctx, state, arm).tolist()}
+    fresh = c.state(ctx, hints); look = None
+    if 'board' not in fresh.get('poses', {}):
+        fresh, look = _free_wrist_case_look(ctx, state, arm, hints)
+    record = dict(kind='stale_observation_refresh', age_s=age, case_look=look)
+    if 'board' not in fresh.get('poses', {}):
+        return state, {**record, 'adopted': False, 'reason': 'fresh packets lack the case'}
+    return save_observation(state, fresh), {**record, 'adopted': True, 'timestamp': fresh['timestamp']}
+
+
+def _held_look_scope(state, envelope_m=.008):
+    """Screening inputs for a free-arm look at the held part: the attributed
+    planning scene, the holder's declared contact bead and the board brace."""
+    plan = state.get('plan', {})
+    return dict(scene=state.get('planning_scene') or None,
+                holder_beads=[int(plan['index'])] if 'index' in plan else [],
+                anchor_evidence=state.get('support_anchor_evidence'), envelope_m=float(envelope_m))
+
+
+def _free_wrist_case_look(ctx, state, holder, hints):
+    """The free hand carries its wrist camera to the precomputed survey look of
+    its own side that best centres the case (aimed at the dated RGB case pose;
+    aim only), observes with the gantry and both wrists, and returns home. The
+    holding hand does not move."""
+    from .survey import choose_look
+    free = 1-int(holder); side = 'left' if free == 0 else 'right'
+    board = (state['observation'].get('poses', {}).get('board')
+             or next((row['poses']['board'] for row in reversed(state.get('rgb_history', [])) if 'board' in row.get('poses', {})), None))
+    if board is None:
+        return c.state(ctx, hints), dict(refused='no dated case pose to aim at')
+    chosen = choose_look(board, side=side)
+    if chosen is None:
+        return c.state(ctx, hints), dict(refused='no survey look of the free arm sees the case')
+    _, _, joints, score = chosen
+    from . import free_arm_motion as fam
+    scope = _held_look_scope(state)
+    if scope['scene'] is None:
+        return c.state(ctx, hints), dict(refused='no planning scene to screen the free-arm case look')
+    name = state['piece']
+    try:
+        motion = fam.move_to(ctx, free, joints, scene=scope['scene'], anchor_evidence=scope['anchor_evidence'],
+                             held=fam.held_part(ctx, name, hints[name], holder, scope['holder_beads'], scope['envelope_m']))
+    except fam.FreeArmRefusal as error:
+        return c.state(ctx, hints), dict(refused='no screened free-arm case look path: '+str(error)[:300])
+    ctx.tool('robot.wait_steps', steps=20)
+    fresh = c.state(ctx, hints)
+    home = fam.go_home(ctx, motion)
+    return fresh, dict(free_arm=free, look_joints=list(joints), centring_px=score, case_measured='board' in fresh.get('poses', {}),
+                       home_result=home)
+
+
+# ------------------------------------------------- held source age remeasurement
+# A held-belief propagation that its 30 s age scope refuses after long
+# planning (heavy host load: the sim keeps stepping while the policy computes)
+# is answered by measuring the held part now, before any motion, from its
+# current holder pose. The 30 s limit itself is unchanged; the new source starts
+# its own 30 s.
+HELD_REMEASURE_MAX_INNOVATION_M = .020   # as the Red sender rebind (_fresh_sender)
+HELD_REMEASURE_MAX_HAND_GAP_M = .045     # as every held-part RGB contradiction check
+# A held part can turn slowly about its gripped bead while the policy computes
+# (Red: ~0.2 mm/s); its far beads then contradict the dated attachment
+# although the grip itself holds. The part is still in the grip when the
+# loaded jaw encoders and the current fit put the contact bead between the
+# pads, close to where the attachment had it.
+IN_GRIP_LOADED_WIDTH_M = (.010, .045)    # loaded source minimum .. open
+IN_GRIP_BEAD_DEPTH_M = (.004, .0165)     # bead centre along TCP z, up to the public pad front
+IN_GRIP_BEAD_LATERAL_M = .008            # |x| along the pad face
+IN_GRIP_BEAD_CLOSING_M = .004            # |y| between the closing pads
+IN_GRIP_BEAD_SHIFT_M = .006              # contact bead move in the TCP frame vs the attachment
+
+
+def held_aim(ctx, state, name, arm):
+    """Aim-only held prediction: the holder's current FK x the dated source's own
+    relative transform (source RGB pose and its synchronous q16 through public
+    FK), or the conditional attachment's declared transform. Never a measurement."""
+    from .red_bimanual_handoff import geometry
+    from .vision_planning import finite_fk
+    p = state['parameters']; side = 'left' if int(arm) == 0 else 'right'
+    source = p.get('owned_held_belief_source') or {}
+    attachment = p.get('conditional_attachment') or state.get('conditional_attachment') or {}
+    if 'robot_encoder_values' in source and 'pose' in source and not p.get('conditional_attachment_id'):
+        g = geometry(); q = np.asarray(source['robot_encoder_values'], float); g.fk(q)
+        pp, qq = finite_fk(g.robot.iks[side], q); R0 = Rotation.from_quat(qq).as_matrix()
+        body = np.asarray(source['pose'], float)
+        rel_p = R0.T@(body[:3]-np.asarray(pp)); rel_R = R0.T@Rotation.from_quat(body[3:]).as_matrix(); bound = .006
+    elif 'object_in_tcp_position' in attachment:
+        rel_p = np.asarray(attachment['object_in_tcp_position'], float)
+        rel_R = np.asarray(attachment['object_in_tcp_rotation'], float); bound = float(attachment.get('uncertainty_m', .008))
+    else:
+        return None
+    now = ctx.tool('robot.read_proprioception', arm_id=int(arm)); R = Rotation.from_quat(now['tcp'][3:]).as_matrix()
+    return dict(predicted_body_pose=[*(np.asarray(now['tcp'][:3])+R@rel_p).tolist(), *Rotation.from_matrix(R@rel_R).as_quat().tolist()],
+                object_in_tcp_position=rel_p.tolist(), object_in_tcp_rotation=rel_R.tolist(),
+                current_robot_encoder_values=now['robot_encoder_values'], uncertainty_m=bound,
+                role='aim and fit seed only; never a measurement')
+
+
+def in_grip(ctx, name, arm, pose, aim, contact_beads):
+    """Is the held part still in the grip? Jaw encoders loaded, and every
+    declared contact bead of the current fit between the pads (TCP frame) and
+    within IN_GRIP_BEAD_SHIFT_M of where the attachment ``aim`` had it."""
+    from . import model
+    now = ctx.tool('robot.read_proprioception', arm_id=int(arm))
+    q = np.asarray(now['robot_encoder_values'], float); off = 8*int(arm)
+    width = float(q[off+6]-q[off+7])
+    tcp = np.asarray(now['tcp'], float); R = Rotation.from_quat(tcp[3:]).as_matrix()
+    local = np.asarray(model.local_beads(name), float); pose = np.asarray(pose, float)
+    current = (local@Rotation.from_quat(pose[3:]).as_matrix().T+pose[:3]-tcp[:3])@R
+    held = local@np.asarray(aim['object_in_tcp_rotation']).T+np.asarray(aim['object_in_tcp_position'])
+    rows = []
+    for bead in contact_beads:
+        x, y, z = current[int(bead)]; shift = float(np.linalg.norm(current[int(bead)]-held[int(bead)]))
+        rows.append(dict(bead=int(bead), bead_in_tcp_m=[float(x), float(y), float(z)], shift_in_tcp_m=shift,
+            passed=bool(IN_GRIP_BEAD_DEPTH_M[0] <= z <= IN_GRIP_BEAD_DEPTH_M[1] and abs(x) <= IN_GRIP_BEAD_LATERAL_M
+                        and abs(y) <= IN_GRIP_BEAD_CLOSING_M and shift <= IN_GRIP_BEAD_SHIFT_M)))
+    passed = bool(contact_beads) and IN_GRIP_LOADED_WIDTH_M[0] <= width <= IN_GRIP_LOADED_WIDTH_M[1] and all(r['passed'] for r in rows)
+    return dict(kind='held_part_in_grip_check', jaw_width_m=width, loaded_width_band_m=list(IN_GRIP_LOADED_WIDTH_M),
+                contact_beads=rows, passed=passed)
+
+
+def adopt_held_fit(ctx, state, name, arm, observed, role):
+    """An accepted current fit of the held part becomes its owned source (in place)."""
+    from .modular_controller import save_observation
+    q16 = observed['robot_geometry_provenance']
+    source = dict(mode='pyramid', piece=name, pose=observed['poses'][name], timestamp=observed['timestamp'],
+                  frame_sha256=observed['frame_sha256'], observation_source=observed['observation_source'],
+                  robot_encoder_values=q16['robot_encoder_values'], robot_encoder_sha256=q16['robot_encoder_sha256'],
+                  source_step=q16['step'], source_role=role)
+    state.update(save_observation(state, observed))
+    state['parameters']['owned_held_belief_source'] = source
+    state['parameters'].pop('conditional_attachment_id', None)
+    return source
+
+
+def remeasure_held_source(ctx, state, name, arm, refusal, *, look=None, renew=None,
+                          max_innovation_m=HELD_REMEASURE_MAX_INNOVATION_M, contact_beads=()):
+    """After an age-scope refusal of the held part's propagation: a new
+    accepted RGB packet of the held part (holder still), seeded by held_aim and
+    passing it only as a goal-support site blocker (no alias authority); if the
+    frame does not accept the part, ``look(ctx, state, aim)`` may take one screened
+    free-wrist look (returns an observation or None). An accepted fit within the
+    hand gap and the innovation bound becomes the owned source, in place on
+    ``state`` (the callers keep this dict through their planning), and is
+    propagated under the unchanged 30 s scope; ``renew(ctx, state, observed, aim,
+    belief)`` then lets the caller renew what that packet renews for it (scene,
+    contact regions). A fit beyond the innovation bound is still adopted when
+    in_grip shows the part has only turned about its gripped ``contact_beads``.
+    Otherwise ``refusal`` stands."""
+    from . import visual_memory
+    record = dict(kind='held_source_age_remeasurement', piece=name, arm=int(arm), original_refusal=str(refusal), attempts=[])
+    for attempt in range(MAX_ATTEMPTS):
+        aim = held_aim(ctx, state, name, arm)
+        if aim is None:
+            break
+        pose = list(map(float, aim['predicted_body_pose']))
+        hints = {name: pose, '__goal_support_blocker__': dict(name=name, pose=pose)}
+        now = float(ctx.tool('robot.read_proprioception', arm_id=int(arm))['timestamp'])
+        boards = [row for row in state.get('rgb_history', []) if 'board' in row.get('poses', {}) and 0. <= now-float(row['timestamp']) <= 30.]
+        if boards:
+            hints['board'] = deepcopy(max(boards, key=lambda row: row['timestamp'])['poses']['board'])
+        observed = c.state(ctx, hints); looked = None; row_refusal = None
+        if name not in observed.get('poses', {}) and look is not None:
+            try:
+                looked = look(ctx, state, aim)
+            except c.PlanningRefusal as error:  # no screened look: nothing moved
+                row_refusal = str(error)[:200]; looked = None
+            if looked is not None:
+                observed = looked
+        row = dict(timestamp=observed.get('timestamp'), measured=name in observed.get('poses', {}), free_wrist_look=looked is not None,
+                   look_refusal=row_refusal)
+        record['attempts'].append(row)
+        if name not in observed.get('poses', {}):
+            continue
+        tcp = np.asarray(ctx.tool('robot.read_proprioception', arm_id=int(arm))['tcp'][:3], float)
+        gap = float(c.part_hand_gap(name, observed['poses'][name], tcp))
+        innovation = float(visual_memory.shape_displacement(name, pose, observed['poses'][name]))
+        row.update(hand_bead_gap_m=gap, innovation_from_aim_m=innovation)
+        if gap > HELD_REMEASURE_MAX_HAND_GAP_M:
+            raise StageRefusal('Current RGB contradicts the retained held part after its age scope ' + str(row))
+        if innovation > max_innovation_m:
+            row['in_grip'] = grip = in_grip(ctx, name, arm, observed['poses'][name], aim, contact_beads)
+            if not grip['passed']:
+                raise StageRefusal('Current RGB contradicts the retained held part after its age scope ' + str(row))
+        source = adopt_held_fit(ctx, state, name, arm, observed,
+                                'Actual accepted current held RGB and synchronous robot q16 (age-scope remeasurement)')
+        state.setdefault('held_source_age_remeasurements', []).append({**record, 'source_timestamp': observed['timestamp']})
+        belief = ctx.tool('puzzle.propagate_pyramid_held_belief', source=source, arm_id=int(arm))
+        if renew is not None:
+            renew(ctx, state, observed, aim, belief)
+        return belief
+    raise refusal
+
+
+def admit_or_in_grip(ctx, name, arm, belief, observed, parameters, contact_beads):
+    """check_bounded_release, except that a current fit which contradicts the
+    dated held estimate only because the part turned about its gripped bead
+    (in_grip: loaded jaws, contact bead between the pads within 6 mm of where
+    the attachment had it, part within the 45 mm hand gap) is admitted as a
+    fresh measurement; the caller then makes it the owned source, as it does
+    for any admitted packet. Any other contradiction refuses as before."""
+    from .release_admission import check_bounded_release
+    from . import visual_memory
+    try:
+        return check_bounded_release(name, belief, observed, parameters)
+    except StageRefusal as error:
+        if 'contradicts the bounded held estimate' not in str(error) or name not in observed.get('poses', {}):
+            raise
+        refusal = error
+    tcp = np.asarray(ctx.tool('robot.read_proprioception', arm_id=int(arm))['tcp'][:3], float)
+    gap = float(c.part_hand_gap(name, observed['poses'][name], tcp))
+    grip = in_grip(ctx, name, arm, observed['poses'][name], belief, contact_beads)
+    if gap > HELD_REMEASURE_MAX_HAND_GAP_M or not grip['passed']:
+        raise refusal
+    source = belief.get('source', {}); source_rgb = source.get('source_rgb', source)
+    return dict(kind='held_part_in_grip_turn_admission', piece=name, owned_source_authenticated=True,
+                current_target_3d_status='measured_current_RGB',
+                conditional_body_bound_m=float(belief.get('uncertainty_m', .006)), physical_guard_body_inflation_m=0.,
+                current_RGB_vs_FK_displacement_m=float(visual_memory.shape_displacement(
+                    name, observed['poses'][name], belief['predicted_body_pose'])),
+                rgb_observability='supported', source_timestamp=source_rgb.get('timestamp'),
+                current_timestamp=belief.get('current_timestamp'), final_receipt_required=True,
+                hand_bead_gap_m=gap, in_grip=grip, original_refusal=str(refusal),
+                scope='The current fit turned about its gripped bead; it becomes the owned source (fresh measurement). '
+                      'The contradicted dated estimate is not used for control.')
diff -ruN '--exclude=__pycache__' clean/policy/puzzler/start_layout.py A/policy/puzzler/start_layout.py
--- a/policy/puzzler/start_layout.py
