diff -ruN '--exclude=__pycache__' clean/policy/puzzler/appearance.py A/policy/puzzler/appearance.py
--- a/policy/puzzler/appearance.py
+++ b/policy/puzzler/appearance.py
@@ -0,0 +1,353 @@
+"""Piece colours measured by the policy itself; no fixed colour-to-part table.
+
+Task assumption: each piece is one uniform colour, but which colour is unknown.
+
+* Grouping: within one frame, lit part pixels are grouped by chroma similarity
+  (``colour_groups``). A group is anonymous.
+* Identity: ``shape_vision.identify`` matches each group's visible bead layout
+  to the twelve public CAD bead layouts; the multi-view pose fit then chooses
+  the best (piece, pose).
+* Measured colour: the colour of a piece identified by shape is read from its
+  own bead pixels in that frame (``measure_beads``) and kept for the episode
+  (``ColourMemory``).
+* Later "does this pixel show piece X" tests and per-piece masks compare a
+  pixel with the colour the policy measured for X, never with a palette.
+
+Two measured colours closer than ``CONFUSABLE_DEG`` cannot be told apart by a
+pixel test, so either label confirms the other's site (as Red and Maroon did
+under the original materials). Two closer than ``MERGE_DEG`` cannot even be
+split by nearest-colour labelling; their masks are one colour group, separated
+by geometry (a CAD pose's projected footprint), never by guessing.
+"""
+import cv2
+import numpy as np
+from scipy.ndimage import gaussian_filter, maximum_filter
+
+from scipy.spatial.transform import Rotation
+
+from .model import CELLS, RADIUS, local_beads
+
+# Lit, saturated part pixels (the thresholds the palette detector used).
+MIN_SPREAD = .10
+MIN_NORM = .12
+DETECT_DOT = .995   # per-pixel tolerance of a piece mask (was: to the palette)
+LABEL_DOT = .985    # per-pixel tolerance of the completion/goal-pixel labels
+CONFUSABLE_DEG = 8.  # pixel tests: colours closer than this confirm each other
+MERGE_DEG = 4.       # masks: colours closer than this are one colour group
+SAMPLE_FRACTION = .45  # bead-centre disc radius (of the bead's image radius) sampled for colour
+# A grey piece (no chroma) is measured as "bright neutral": the foreground rule
+# of shape_vision.foreground (channel spread <= 24, brightest channel > 108).
+# Grey pieces cannot be told apart by colour, nor from the white/grey robot.
+GREY = np.full(3, 1/np.sqrt(3.))
+
+
+SURFACE_MEDIAN = 5  # px: colour of a surface patch, not of one texel (grain, speckle)
+
+
+def surface(rgb, size=SURFACE_MEDIAN):
+    """The image as surface patches: a 5x5 median, which keeps edges sharp and
+    removes texture finer than a few pixels (wood grain, speckle). A uniform
+    colour region is unchanged by it."""
+    a = np.ascontiguousarray(np.asarray(rgb)[..., :3])
+    return cv2.medianBlur(a, int(size)) if a.dtype == np.uint8 and int(size) > 1 else a
+
+
+def bead_image_radius(camera, poses):
+    """Image radius (px) of the nearest bead among the given (name, pose) seeds."""
+    radius = 0.
+    for name, pose in poses:
+        pose = np.asarray(pose, float)
+        depth = float((pose[:3]-camera.camera_to_world[:3, 3]) @ camera.camera_to_world[:3, 2])
+        if depth > .05:
+            radius = max(radius, camera.K[0, 0]*RADIUS/depth)
+    return radius
+
+
+def fill_texture_holes(mask, radius):
+    """Fill enclosed holes smaller than 15% of a bead's image disc.
+
+    A grain of another hue inside a textured piece is not a silhouette edge.
+    The gap between beads of one piece (the centre of a 2x2 block is about
+    half a bead disc) is larger and stays open as silhouette evidence.
+    Grain lines that reach the rim are not enclosed; a 3x3 closing first
+    bridges such slits (at most 2 px wide), far narrower than a neck gap.
+    """
+    if radius <= 0 or not mask.any():
+        return mask
+    mask = cv2.morphologyEx(mask.astype(np.uint8), cv2.MORPH_CLOSE,
+                            cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3)))
+    inverse = (1-mask).astype(np.uint8)
+    count, components, stats, _ = cv2.connectedComponentsWithStats(inverse, connectivity=4)
+    h, w = mask.shape
+    small = .15*np.pi*radius*radius
+    out = mask.copy()
+    for k in range(1, count):
+        x, y, bw, bh, area = stats[k]
+        if area < small and x > 0 and y > 0 and x+bw < w and y+bh < h:
+            out[components == k] = 1
+    return out
+
+
+def chroma(rgb, size=SURFACE_MEDIAN):
+    """Brightness-normalized RGB and the lit-part-pixel mask, of surface patches."""
+    a = surface(rgb, size).astype(np.float32)/255
+    norm = np.linalg.norm(a, axis=2)
+    unit = a/np.maximum(norm[..., None], 1e-6)
+    lit = ((a.max(axis=2)-a.min(axis=2)) > MIN_SPREAD) & (norm > MIN_NORM)
+    return unit, lit
+
+
+def bright_neutral(rgb, size=SURFACE_MEDIAN):
+    a = surface(rgb, size).astype(np.int16)
+    high = a.max(axis=2)
+    return ((high-a.min(axis=2)) <= 24) & (high > 108)
+
+
+def angle_deg(a, b):
+    a = np.asarray(a, float); b = np.asarray(b, float)
+    return float(np.degrees(np.arccos(np.clip(a @ b/np.linalg.norm(a)/np.linalg.norm(b), -1., 1.))))
+
+
+def colour_groups(rgb, region=None, min_pixels=60):
+    """Anonymous chroma groups of one frame: (label image, unit centres).
+
+    Modes of the frame's own chroma histogram, refined to the mean of their
+    pixels and merged when closer than MERGE_DEG. A lit pixel joins the
+    nearest centre within DETECT_DOT; others are -1. No part name is used.
+    """
+    unit, lit = chroma(rgb)
+    if region is not None:
+        lit &= np.asarray(region, bool)
+    labels = np.full(lit.shape, -1, np.int32)
+    values = unit[lit]
+    if len(values) < min_pixels:
+        return labels, np.empty((0, 3))
+    azimuth = np.degrees(np.arctan2(values[:, 1], values[:, 0]))
+    polar = np.degrees(np.arccos(np.clip(values[:, 2], -1., 1.)))
+    histogram, _, _ = np.histogram2d(azimuth, polar, bins=(180, 180), range=((-45., 135.), (0., 180.)))
+    smooth = gaussian_filter(histogram, 1.5)
+    peaks = np.argwhere((smooth == maximum_filter(smooth, size=7)) & (smooth >= max(min_pixels/20., 1.)))
+    order = np.argsort(-smooth[peaks[:, 0], peaks[:, 1]])
+    centres, weights = [], []
+    for i, j in peaks[order]:
+        az, po = np.radians(-45.+i+.5), np.radians(j+.5)
+        direction = np.array([np.cos(az)*np.sin(po), np.sin(az)*np.sin(po), np.cos(po)])
+        near = values[values @ direction > np.cos(np.radians(3.))]
+        if len(near) < min_pixels:
+            continue
+        centre = near.mean(axis=0); centre /= np.linalg.norm(centre)
+        if any(angle_deg(centre, c) < MERGE_DEG for c in centres):
+            continue
+        centres.append(centre); weights.append(len(near))
+    if not centres:
+        return labels, np.empty((0, 3))
+    centres = np.asarray(centres)
+    scores = values @ centres.T
+    nearest = scores.argmax(axis=1)
+    labels[lit] = np.where(scores.max(axis=1) > DETECT_DOT, nearest, -1)
+    return labels, centres
+
+
+def measure_beads(rgb, pixels, radii):
+    """Colour of one piece from its own bead-centre discs in one image.
+
+    ``pixels``/``radii``: image centres and image radii of beads already
+    attributed to the piece by CAD shape. Uniform colour is checked, not
+    assumed: at least three beads must agree within DETECT_DOT.
+    """
+    unit, lit = chroma(rgb)
+    grey = bright_neutral(rgb)
+    h, w = lit.shape
+    per_bead, samples, neutral_beads, discs = [], [], 0, 0
+    for (u, v), radius in zip(np.asarray(pixels, float), np.asarray(radii, float)):
+        r = max(2., SAMPLE_FRACTION*radius)
+        if not (r+1 < u < w-r-1 and r+1 < v < h-r-1):
+            continue
+        yy, xx = np.mgrid[int(v-r):int(v+r)+1, int(u-r):int(u+r)+1]
+        inside = (xx-u)**2+(yy-v)**2 <= r*r
+        yy, xx = yy[inside], xx[inside]
+        discs += 1
+        ok = lit[yy, xx]
+        if ok.mean() < .5:
+            neutral_beads += int(grey[yy, xx].mean() >= .5)
+            continue
+        values = unit[yy[ok], xx[ok]]
+        mean = np.median(values, axis=0)  # robust to grain and speckle
+        per_bead.append(mean/np.linalg.norm(mean)); samples.append(values)
+    if len(per_bead) < 3:
+        # No chroma: a uniformly grey piece is measured as bright neutral.
+        if neutral_beads >= 3 and neutral_beads >= .75*discs:
+            return dict(chroma=[float(v) for v in GREY], neutral=True, beads=int(neutral_beads), pixels=0,
+                        spread_p90_deg=0.)
+        return None
+    per_bead = np.asarray(per_bead)
+    median = np.median(per_bead, axis=0); median /= np.linalg.norm(median)
+    agree = per_bead @ median > DETECT_DOT
+    if agree.sum() < 3 or agree.mean() < .75:
+        return None
+    values = np.concatenate([s for s, a in zip(samples, agree) if a])
+    centre = values.mean(axis=0); centre /= np.linalg.norm(centre)
+    spread = np.degrees(np.arccos(np.clip(values @ centre, -1., 1.)))
+    return dict(chroma=[float(v) for v in centre], beads=int(agree.sum()), pixels=int(len(values)),
+                spread_p90_deg=float(np.percentile(spread, 90)))
+
+
+class ColourMemory:
+    """The episode's measured piece colours. First shape-identified measurement wins.
+
+    A later measurement of the same piece that disagrees by MERGE_DEG or more
+    is recorded as a conflict and never overwrites the stored colour. A colour
+    from a partial or ambiguous CAD assignment is only staged; it becomes the
+    piece's colour once that track has an accepted multi-view fit (promote).
+    """
+
+    def __init__(self):
+        self.colours = {}
+        self.pending = {}
+        self.conflicts = []
+
+    def stage(self, measured, source, timestamp=None):
+        for name, row in (measured or {}).items():
+            if name in CELLS and row and name not in self.colours and name not in self.pending:
+                self.pending[name] = dict(row, source=source, timestamp=timestamp)
+
+    def promote(self, names):
+        for name in names:
+            row = self.pending.pop(name, None)
+            if row is not None:
+                self.learn({name: row}, source=row['source']+'; confirmed by an accepted multi-view fit', timestamp=row['timestamp'])
+
+    def learn(self, measured, source, timestamp=None):
+        for name, row in (measured or {}).items():
+            if name not in CELLS or not row:
+                continue
+            if name not in self.colours:
+                self.colours[name] = dict(row, source=source, timestamp=timestamp)
+            elif angle_deg(row['chroma'], self.colours[name]['chroma']) >= MERGE_DEG:
+                self.conflicts.append(dict(name=name, source=source, timestamp=timestamp, chroma=row['chroma'],
+                                           stored=self.colours[name]['chroma']))
+
+    def names(self):
+        return [n for n in CELLS if n in self.colours]
+
+    def matrix(self):
+        names = self.names()
+        return names, np.asarray([self.colours[n]['chroma'] for n in names], np.float32).reshape(-1, 3)
+
+    def within(self, name, degrees):
+        if name not in self.colours:
+            return set()
+        own = self.colours[name]['chroma']
+        return {other for other in self.names() if other != name and angle_deg(own, self.colours[other]['chroma']) < degrees}
+
+    def confusable(self, name):
+        return self.within(name, CONFUSABLE_DEG)
+
+    def merged(self, name):
+        return self.within(name, MERGE_DEG)
+
+    def labels(self, rgb, dot=LABEL_DOT, size=1):
+        """Nearest measured piece colour per pixel; -1 where none is within ``dot``.
+
+        Chromatic measured colours compete on lit pixels; a grey (neutral)
+        measured colour claims the bright neutral pixels no chromatic one took.
+        """
+        names, colours = self.matrix()
+        unit, lit = chroma(rgb, size)
+        labels = np.full(lit.shape, -1)
+        if not names:
+            return labels, names
+        chromatic = [i for i, n in enumerate(names) if not self.colours[n].get('neutral')]
+        if chromatic:
+            scores = unit @ colours[chromatic].T
+            labels = np.where(lit & (scores.max(axis=2) > dot), np.asarray(chromatic)[scores.argmax(axis=2)], -1)
+        greys = [i for i, n in enumerate(names) if self.colours[n].get('neutral')]
+        if greys:
+            labels = np.where((labels < 0) & bright_neutral(rgb, size), greys[0], labels)
+        return labels, names
+
+    def summary(self):
+        return {n: dict(chroma=[round(v, 4) for v in row['chroma']], neutral=bool(row.get('neutral')),
+                        spread_p90_deg=round(row['spread_p90_deg'], 2), source=row['source'], timestamp=row['timestamp'])
+                for n, row in self.colours.items()}
+
+
+_ACTIVE = [ColourMemory()]
+
+
+def active():
+    """The observer's colour memory (one policy instance per process)."""
+    return _ACTIVE[0]
+
+
+def activate(memory):
+    _ACTIVE[0] = memory
+    return memory
+
+
+def footprint(name, pose, camera, shape, pad=9):
+    """Image discs of a CAD pose's beads (radius + pad pixels); geometry only."""
+    roi = np.zeros(shape, np.uint8)
+    pose = np.asarray(pose, float)
+    centers = local_beads(name) @ Rotation.from_quat(pose[3:]).as_matrix().T+pose[:3]
+    depth = (centers-camera.camera_to_world[:3, 3]) @ camera.camera_to_world[:3, 2]
+    pixels = camera.project(centers)
+    for pixel, z in zip(pixels, depth):
+        if z <= .02 or not np.isfinite(pixel).all():
+            continue
+        radius = int(np.ceil(camera.K[0, 0]*RADIUS/z))+pad
+        cv2.circle(roi, tuple(int(v) for v in np.rint(pixel)), radius, 1, -1)
+    return roi
+
+
+def piece_masks(rgb, only_names=None, camera=None, near=None, memory=None):
+    """Per-piece masks from the measured colours of one image.
+
+    Every measured colour competes for every pixel (nearest wins, within
+    DETECT_DOT), so a request for one piece cannot take another's pixels.
+    Colours closer than MERGE_DEG form one group; such a group's components
+    are attributed to a piece only where they touch the projected footprint
+    of a pose supplied for it in ``near`` (an optimizer seed or the pose under
+    test), otherwise the mask stays empty. An unmeasured piece's mask is empty.
+    """
+    memory = memory or active()
+    seeds = [(n, p) for n, value in (near or {}).items() if n in CELLS
+             for p in ([value] if np.asarray(value, dtype=float).ndim == 1 else value)]
+    labels, names = memory.labels(rgb, DETECT_DOT)
+    radius = bead_image_radius(camera, seeds) if camera is not None and seeds else 0.
+    wanted = [n for n in CELLS if only_names is None or n in only_names]
+    empty = np.zeros(labels.shape, np.uint8)
+    if not names:
+        return {n: empty.copy() for n in wanted}
+    masks = {}
+    for name in wanted:
+        if name not in memory.colours:
+            masks[name] = empty.copy()
+            continue
+        group = [name, *sorted(memory.merged(name))]
+        mask = np.isin(labels, [names.index(n) for n in group]).astype(np.uint8)
+        joined = cv2.dilate(mask, np.ones((7, 7), np.uint8))
+        count, components, stats, _ = cv2.connectedComponentsWithStats(joined)
+        if count <= 1:
+            masks[name] = mask
+            continue
+        if len(group) == 1:
+            # Unchanged from the palette detector: keep the largest spatial group.
+            sizes = np.bincount(components.ravel(), weights=mask.ravel(), minlength=count)
+            sizes[0] = 0
+            masks[name] = (mask & (components == sizes.argmax())).astype(np.uint8)
+            continue
+        poses = (near or {}).get(name)
+        if camera is None or poses is None:
+            masks[name] = empty.copy()
+            continue
+        poses = [poses] if np.asarray(poses, dtype=float).ndim == 1 else list(poses)
+        roi = np.zeros(labels.shape, np.uint8)
+        for pose in poses:
+            roi |= footprint(name, pose, camera, labels.shape)
