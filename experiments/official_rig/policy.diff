diff -ruN '--exclude=__pycache__' clean/policy/puzzler/red_source_prescreen.py A/policy/puzzler/red_source_prescreen.py
--- a/policy/puzzler/red_source_prescreen.py
+++ b/policy/puzzler/red_source_prescreen.py
@@ -0,0 +1,122 @@
+"""Red source grasp: same-arm self-clearance pre-screen (official rig start layouts).
+
+Red's public bead-4 side pinch is near the right arm's link_3/link_5 contact
+for some source poses. The simulator filters each arm's self contacts, so a
+folded IK branch is executed and the arm passes through itself on the lift;
+afterwards every full public robot guard refuses at its first sample
+(slod_demo_4/8: link_3 into link_5 by 32 mm at the hand-off).
+
+Before choosing a source grasp, the planner runs this pre-screen with no
+motion: public IK seeded as the native solver's live seed would be (current
+encoders -> hover -> grasp -> lift), then the public robot colliders on the
+dense joint segments the motions follow. A grasp passes when the approach,
+the descent and the grasp keep the 0.5 mm same-arm/cross-arm/table floor and
+at least one of the declared screened-lift proposals passes the same rule as
+modular_red_contact.screened_lift. Gates are unchanged; a refusal only moves
+the planner on to the next declared pinch heading.
+"""
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+from . import modular_red_placement as base
+
+# The hand-off later opens this (sender) hand around Red: the opening sweep
+# keeps 0.5 mm from every non-contract bead for the actual attachment
+# (slom_scatter_1: -0.27 mm at the closed width after a +10 deg pinch, whose
+# nominal recipe kept only 1.3 mm). Nominally, a pinch must keep this much so a
+# measured attachment a few mm off still passes that unchanged gate.
+OPENING_SWEEP_NOMINAL_CLEARANCE_M = .002
+OPENING_SWEEP_WIDTHS_M = (.024, .055)   # loaded close .. source open
+
+
+def opening_sweep(body, grasp, hand_R, contact_bead, widths=OPENING_SWEEP_WIDTHS_M):
+    """Nominal finger clearance to Red's non-contract beads from the loaded close
+    to the open width, with the hand at this source pinch (public CAD only)."""
+    from . import model
+    from .gripper_geometry import clearance
+    body = np.asarray(body, float); R = Rotation.from_quat(body[3:]).as_matrix()
+    local = np.asarray(model.local_beads('red'), float)
+    others = local[[i for i in range(len(local)) if i != int(contact_bead)]]@R.T+body[:3]
+    worst = min(float(clearance(np.asarray(grasp, float), np.asarray(hand_R, float), float(w), others)['clearance_m'])
+                for w in np.linspace(widths[0], widths[1], 8))
+    return dict(kind='red_sender_opening_sweep_nominal', minimum_clearance_m=worst,
+                required_m=OPENING_SWEEP_NOMINAL_CLEARANCE_M, passed=bool(worst >= OPENING_SWEEP_NOMINAL_CLEARANCE_M))
+
+
+def _material(g, q16):
+    groups = g.robot_material(q16)
+    return (float(groups['same_arm_nonadjacent']['clearance_m']), float(groups['cross_arm']['clearance_m']),
+            float(groups['moving_robot_table']['clearance_m']))
+
+
+def _segment(g, q16, arm, a, b):
+    """Worst (same-arm, cross-arm, table) clearance on the joint line a -> b."""
+    off = 8*arm; a = np.asarray(a, float); b = np.asarray(b, float)
+    count = max(8, int(np.ceil(np.max(np.abs(b-a))/.012)))
+    worst = [np.inf, np.inf, np.inf]
+    for u in np.linspace(0., 1., count+1):
+        qq = np.asarray(q16, float).copy(); qq[off:off+6] = a+(b-a)*u
+        worst = [min(w, v) for w, v in zip(worst, _material(g, qq))]
+    return worst
+
+
+def screen(ctx, arm, grasp, hand_R, p, body=None, contact_bead=None):
+    from .red_bimanual_handoff import geometry
+    from .modular_red_contact import _lift_proposals, LIFT_SELF_CLEARANCE_M, LIFT_PATH_FLOOR_M
+    g = geometry(); ik = g.robot.iks['left' if arm == 0 else 'right']; off = 8*arm
+    lower = g.model.joint_limit_lower.numpy()[ik.arm_dofs]; upper = g.model.joint_limit_upper.numpy()[ik.arm_dofs]
+    reserve = float(p.get('min_ik_joint_margin_rad', .035))
+    quat = Rotation.from_matrix(np.asarray(hand_R, float)).as_quat()
+    q16 = np.asarray(base.proprio(ctx, arm)['robot_encoder_values'], float)
+    grasp = np.asarray(grasp, float)
+    record = dict(kind='red_source_same_arm_prescreen', floor_m=LIFT_PATH_FLOOR_M,
+                  lift_endpoint_floor_m=LIFT_SELF_CLEARANCE_M, passed=False)
+    if body is not None and contact_bead is not None:
+        record['opening_sweep'] = sweep = opening_sweep(body, grasp, hand_R, contact_bead)
+        if not sweep['passed']:
+            return dict(record, refusal='sender opening sweep keeps less than the nominal clearance to non-contract beads')
+
+    def solve(position, seed):
+        sol = np.asarray(ik.solve_q_full(seed, np.asarray(position, float), quat), float)
