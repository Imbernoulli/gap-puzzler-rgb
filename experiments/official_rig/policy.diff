+    if difference >= VIEW_AGREEMENT_M:
+        return dict(visible=False, reason='independent case RGB corner fits disagree', **diagnostic)
+    # Ambiguity: displaced starts must return here or explain fewer edges.
+    supported = sum(s >= EDGE_SIDE_SPAN_M for s in spans)
+    if supported < 4:
+        base = sum(v['inliers'] for v in adopted.values())
+        c, s = math.cos(x[2]), math.sin(x[2])
+        for dx, dy, dyaw in ((.008, 0, 0), (-.008, 0, 0), (0, .008, 0), (0, -.008, 0), (0, 0, .035), (0, 0, -.035)):
+            start = np.r_[x[:2]+np.array([c*dx-s*dy, s*dx+c*dy]), x[2]+dyaw]
+            other = _edge_fit({k: samples[k] for k in adopted}, cameras, start)
+            if other is None:
+                continue
+            separation = float(np.linalg.norm(_corner_points(other)-_corner_points(x), axis=1).max())
+            if separation < .001:
+                continue
+            ov, oa, osp, osg = _assess_edge_fit({k: samples[k] for k in adopted}, cameras, other)
+            if (set(oa) == set(adopted) and _two_sided(osp)
+                    and sum(v['inliers'] for v in oa.values()) >= .9*base):
+                return dict(visible=False, reason='ambiguous case outline: displaced start converges elsewhere',
+                            alternative_corner_difference_m=separation, **diagnostic)
+    # Plane-metric equivalent of the worst adopted view's median (old field name).
+    metric = max(adopted[k]['median_px']*float((np.r_[x[:2], CASE_Z]-cameras[k].camera_to_world[:3, 3])
+                                                 @cameras[k].camera_to_world[:3, 2])/float(cameras[k].K[0, 0])
+                 for k in adopted)
+    return dict(visible=True, pose=_pose7(x), method='multi-view projected-CAD silhouette edge fit',
+                median_outline_residual_m=float(metric), assumption='level table support; board yaw within +/-90 degrees',
+                extent_m=[.220, .315], **diagnostic)
+
+
+def fit_board_views(images, cameras, proposal_pose=None):
+    """Current case pose from all calibrated RGB views of this capture.
+
+    The optimizer seed is the gantry view's planar outline when it passes its
+    own gates; otherwise a historical RGB pose (optimizer proposal only, never
+    a measurement). Without either, the case refuses. Acceptance is decided
+    only by fit_case_views' current-image gates.
+    """
