@@ -0,0 +1,952 @@
+"""Start-layout generality: screened lift and wider source-grasp search.
+
+Inputs are the current RGB planning scene, public CAD, the public robot model
+and robot encoders. No simulator object state is read. Every candidate is
+screened before any motor command; a refused candidate sends nothing.
+"""
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+from . import model
+from . import vision_controller as c
+
+# Public bench mount of the two YAM bases (world xy), as in gripper_geometry.
+ARM_BASE_XY = {0: np.array([.2525, .31]), 1: np.array([.2525, -.31])}
+LIFT_MARGIN_M = .0005
+
+
+def _held_cover(name):
+    from .conditional_scene import local_sphere_cover
+    return local_sphere_cover(name)
+
+
+def _transform(position, quaternion):
+    T = np.eye(4)
+    T[:3, :3] = Rotation.from_quat(np.asarray(quaternion, float)).as_matrix()
+    T[:3, 3] = np.asarray(position, float)
+    return T
+
+
+def _lift_candidates(g, arm, lift):
+    """Straight up first (the original lift), then up-and-away from the own
+    arm base: after 30 mm of vertical clearance the held part moves outward so
+    it cannot meet the shoulder links when its source lies near the base."""
+    away = np.asarray(g[:2], float)-ARM_BASE_XY[int(arm)]
+    away = away/max(np.linalg.norm(away), 1e-9)
+    rise = np.array([0., 0., .030])
+    out = [('straight', [np.array([0., 0., lift])])]
+    for reach, height in ((.040, lift), (.070, lift), (.060, .060)):
+        out.append((f'away_{int(reach*1000)}mm_up_{int(height*1000)}mm',
+                    [rise, np.array([away[0]*reach, away[1]*reach, height])]))
+    return out
+
+
+def _scene_spheres(state, name):
+    from . import conditional_scene
+    scene = state.get('planning_scene') or {}
+    if not scene.get('occupancy'):
+        return np.zeros((0, 3)), np.zeros(0)
+    return conditional_scene.spheres(scene, exclude=(name,))
+
+
+def screen_lift_path(geometry, start16, plans, arm, rel, name, scene_centers, scene_radii):
+    """Sampled robot-vs-held-part and held-part-vs-scene clearance along the
+    joint-space lines the controller will feed (feed_joint_plan)."""
+    side = 'left' if int(arm) == 0 else 'right'
+    coords = list(range(0, 6)) if int(arm) == 0 else list(range(8, 14))
+    local, sizes = _held_cover(name)
+    labels = [geometry.shape_labels[int(s)] for s in geometry.physical_ids]
+    own_finger = np.array([(f'/{side}_arm/' in l or f'{side}_' in l) and ('_lf_' in l or '_rf_' in l or 'finger' in l)
+                           for l in labels])
+    worst_robot = float('inf'); worst_scene = float('inf'); initial_scene = None; witness = None
+    q = np.asarray(start16, float).copy()
+    for plan in plans:
+        a = q[coords].copy(); b = np.asarray(plan['joints'], float)
+        for u in np.linspace(0., 1., 9):
+            sample = q.copy(); sample[coords] = a+(b-a)*u
+            geometry.fk(sample)
+            p, r = geometry.robot.iks[side].ee_pose(geometry.scratch)
+            T = _transform(p, r) @ rel
+            centers = local @ T[:3, :3].T+T[:3, 3]
+            D = geometry._robot_sphere_distances(centers, sizes)
+            D = np.where(own_finger[:, None], np.inf, D)
+            k = np.unravel_index(int(np.argmin(D)), D.shape)
+            if float(D[k]) < worst_robot:
+                worst_robot = float(D[k]); witness = labels[k[0]]
+            if len(scene_centers):
+                d = float((np.linalg.norm(centers[:, None]-scene_centers[None], axis=2)-sizes[:, None]-scene_radii[None]).min())
+                if initial_scene is None:
+                    initial_scene = d
+                worst_scene = min(worst_scene, d)
+        q[coords] = b
+    scene_ok = initial_scene is None or worst_scene >= min(LIFT_MARGIN_M, initial_scene-1e-4)
+    return dict(passed=bool(worst_robot >= LIFT_MARGIN_M and scene_ok), robot_clearance_m=worst_robot,
+                robot_witness=witness, held_scene_clearance_m=worst_scene if np.isfinite(worst_scene) else None,
+                held_scene_initial_m=initial_scene)
+
+
+def screened_lift(ctx, state, arm, g, q, lift):
+    """Lift the closed hand. The original straight lift is used whenever it
+    screens clear; otherwise the first clear up-and-away lift. Returns the
+    executed TCP offset and a record."""
+    record = dict(candidates=[])
+    try:
+        from .cyan_bimanual_adapter import _geometry
+        geometry = _geometry()
+        packet = ctx.tool('robot.read_proprioception', arm_id=arm)
+        start16 = np.asarray(packet['robot_encoder_values'], float)[:16]
+        tcp, tcp_q = c.hand(ctx, arm)
+        body = np.asarray(state['plan']['body'], float)
+        rel = np.linalg.inv(_transform(tcp, c.qarr(tcp_q))) @ _transform(body[:3], body[3:])
+        centers, radii = _scene_spheres(state, state['piece'])
+    except Exception as error:  # no public geometry: keep the original lift
+        record['unscreened'] = f'{type(error).__name__}: {error}'
+        c.move(ctx, np.asarray(g)+[0, 0, lift], q, arm)
+        return np.array([0., 0., lift]), record
+    chosen = None
+    for label, offsets in _lift_candidates(g, arm, lift):
+        plans = []
+        for offset in offsets:
+            plan = ctx.tool('puzzle.plan_pose', position=(np.asarray(g)+offset).tolist(), rotation=q, arm_id=arm)
+            plans.append(plan)
+            if plan['position_error_m'] > .002 or plan['rotation_error_rad'] > .03:
+                break
+        if len(plans) < len(offsets) or plans[-1]['position_error_m'] > .002 or plans[-1]['rotation_error_rad'] > .03:
+            record['candidates'].append(dict(lift=label, refused='ik'))
+            continue
+        jumps = [float(np.max(np.abs(np.asarray(b['joints'])-np.asarray(a)))) for a, b in
+                 zip([plans[0]['current']]+[x['joints'] for x in plans[:-1]], plans)]
+        if max(jumps) > .6:
+            record['candidates'].append(dict(lift=label, refused='ik_branch_jump', joint_jump_rad=max(jumps)))
+            continue
+        screen = screen_lift_path(geometry, start16, plans, arm, rel, state['piece'], centers, radii)
+        record['candidates'].append(dict(lift=label, **screen))
+        if screen['passed']:
+            chosen = (label, offsets)
+            break
+    if chosen is None:
+        record['fallback'] = 'no screened lift clear; original straight lift'
+        chosen = ('straight', [np.array([0., 0., lift])])
+    record['chosen'] = chosen[0]
+    for offset in chosen[1]:
+        c.move(ctx, np.asarray(g)+offset, q, arm)
+    return np.asarray(chosen[1][-1], float), record
+
+
+class _PlanningCtx:
+    """Memoize pure planning queries during one planning call (no motion is
+    sent in between): grasp frames and IK at identical requests."""
+    def __init__(self, ctx):
+        self.ctx = ctx if not isinstance(ctx, _PlanningCtx) else ctx.ctx
+        self.cache = {}
+
+    def __getattr__(self, name):
+        return getattr(self.ctx, name)
+
+    @staticmethod
+    def _key(name, kwargs):
+        def norm(v):
+            if isinstance(v, dict):
+                return tuple(sorted((k, norm(x)) for k, x in v.items()))
+            if isinstance(v, (list, tuple, np.ndarray)):
+                return tuple(norm(x) for x in v)
+            if isinstance(v, (float, np.floating)):
+                return round(float(v), 7)
+            return v
+        return name, norm(kwargs)
+
+    def tool(self, name, **kwargs):
+        if name not in ('robot.grasp_frame', 'puzzle.plan_pose'):
+            return self.ctx.tool(name, **kwargs)
+        key = self._key(name, kwargs)
+        if key not in self.cache:
+            self.cache[key] = self.ctx.tool(name, **kwargs)
+        from copy import deepcopy
+        return deepcopy(self.cache[key])
+
+
+# ------------------------------------------------------------ wider grasp search
+WIDE_HEADINGS = [float(h) for h in range(0, 360, 30)]
+FINE_HEADINGS = [float(h) for h in range(0, 360, 15)]
+WIDE_STAGES = (
+    # (label, keep the profile's bead/heading, headings, open widths, leans, extra grasp heights)
+    ('tuned_grasp_narrower_opening', True, None, (.045, .040), None, ()),
+    ('every_bead_heading_30deg', False, WIDE_HEADINGS, (.055, .045, .040), (0.,), (.010, .014)),
+    ('every_bead_heading_15deg_leaning', False, FINE_HEADINGS, (.045, .035), (0., 30., -30., 45., -45.), (.014,)),
+)
+
+
+def _hand_frame(world_heading_deg, lean_deg):
+    """robot.grasp_frame for the YAM hand (approach +z, jaw closing +y in the
+    tool frame), as vision_controller.plan composes heading and lean."""
+    h = np.radians(world_heading_deg); t = np.radians(lean_deg)
+    down = np.array([np.sin(h)*np.sin(t), -np.cos(h)*np.sin(t), -np.cos(t)])
+    head = np.array([np.cos(h), np.sin(h), 0.]); head = head-(head @ down)*down
+    head = head/np.linalg.norm(head)
+    return np.c_[np.cross(head, down), head, down]
+
+
+def screened_plan(ctx, name, q, arm, observed, scene):
+    """vision_controller.plan over a large candidate family, faster: a cheap
+    open-hand clearance test at the grasp pose drops blocked (bead, heading,
+    lean, height) combinations first; every survivor still goes through the
+    complete unchanged vision_controller.plan screens."""
+    special = (q.get('grasp_pairs') or q.get('object_relative_grasp_se3') or q.get('source_contact_grasp')
+               or not q.get('hand_clearance') or not q.get('grasp_auto'))
+    if special:
+        return c.plan(ctx, name, q, arm, observation=observed, planning_scene=scene)
+    from . import conditional_scene
+    from .gripper_geometry import clearance, scene_clearance
+    body = np.asarray(observed['poses'][name], float); R = Rotation.from_quat(body[3:]).as_matrix()
+    yaw = float(np.degrees(Rotation.from_quat(body[3:]).as_euler('xyz')[2]))
+    board = np.asarray(observed['poses']['board'], float) if 'board' in observed['poses'] else _board_pose(scene)
+    table = float(board[2]-.003); margin = q.get('hand_clearance_margin', .0005)
+    width = float(q.get('source_open_width', q.get('open_width', .055)))
+    centers, radii = conditional_scene.spheres(scene)
+    local = model.local_beads(name)
+    beads = q.get('grasp_indices') or list(range(len(local)))
+    headings = q.get('grasp_headings', [90.]); leans = q.get('grasp_leans', [0.])
+    heights = q.get('grasp_heights', [q.get('grasp_z', 0.)])
+    groups = []
+    for i in sorted(beads, key=lambda k: float(np.linalg.norm(local[k]))):
+        actual = body[:3]+R@local[i]
+        for heading in headings:
+            world = heading+yaw if q.get('perceive_yaw', True) else heading
+            passing = []
+            for gz in heights:
+                for lean in leans:
+                    Rh = _hand_frame(world, lean)
+                    position = actual+np.array([q.get('pick_bias', 0.), 0., gz])
+                    if clearance(position, Rh, width, centers, radius=radii)['clearance_m'] < margin:
+                        continue
+                    if scene_clearance(position, Rh, width, [], table_z=table, plane_z=table, board=board)['clearance_m'] < margin:
+                        continue
+                    passing.append((gz, lean))
+            if passing:
+                groups.append((i, heading, passing))
+    errors = []
+    for i, heading, passing in groups:
+        sub = {**q, 'grasp_indices': [int(i)], 'grasp_headings': [float(heading)],
+               'grasp_heights': list(dict.fromkeys(g for g, _ in passing)),
+               'grasp_leans': list(dict.fromkeys(l for _, l in passing))}
+        try:
+            found = c.plan(ctx, name, sub, arm, observation=observed, planning_scene=scene)
+        except (c.PlanningRefusal, RuntimeError) as error:
+            errors.append(str(error)[-160:]); continue
+        if sub.get('source_grasp_only'):
+            return found
+        ok, record = carry_prescreen(ctx, name, sub, arm, found, observed, scene)
+        if ok:
+            return {**found, 'carry_prescreen': record}
+        errors.append('carry pre-screen: '+str(record)[:160])
+    raise c.PlanningRefusal(f'No screened grasp for {name}: {len(groups)} open-hand-clear groups; ' + str(errors[-2:]))
+
+
+def wide_source_plan(ctx, name, p, arm_candidates, observed, scene):
+    """After the profile's grasps are refused: the same CAD grasp family with
+    narrower jaw openings, every bead at 30 deg jaw headings, then leaning
+    approaches. Every candidate passes the unchanged hand-clearance sweep,
+    release clearance, target-approach, IK and joint-reserve screens of
+    vision_controller.plan. Returns (plan, arm, parameter_update, errors)."""
+    errors = []; ctx = _PlanningCtx(ctx)
+    for label, tuned, headings, widths, leans, heights in WIDE_STAGES:
+        for width in widths:
+            q = {**p, 'source_open_width': float(width)}
+            if not tuned:
+                q['grasp_headings'] = list(headings)
+                q.pop('grasp_indices', None)
+                # The profile's own lean and height first: they were tuned for
+                # this part's insertion and post-lift visibility.
+                own = [float(v) for v in p.get('grasp_leans', [0.])]
+                q['grasp_leans'] = list(dict.fromkeys([*own, *leans]))
+                own_heights = [float(v) for v in p.get('grasp_heights', [p.get('grasp_z', .006)])]
+                q['grasp_heights'] = list(dict.fromkeys([*own_heights, *heights]))
+            for arm in arm_candidates:
+                try:
+                    plan = screened_plan(ctx, name, q, arm, observed, scene)
+                except (c.PlanningRefusal, RuntimeError) as error:
+                    errors.append(dict(arm=arm, wide_stage=label, open_width=width, error=str(error)[-300:]))
+                    continue
+                # A grasp the profile was not tuned on: after the lift, look
+                # for the held part (up to two inspection moves) so the release
+                # uses a measured held pose rather than the close-time
+                # attachment alone.
+                update = dict(source_open_width=float(width), grasp_headings=[float(plan['heading'])],
+                              grasp_indices=[int(plan['index'])], grasp_leans=[float(plan['lean'])],
+                              grasp_heights=[float(plan['grasp_height_m'])],
+                              held_inspection_max_moves=max(2, int(p.get('held_inspection_max_moves', 0))))
+                return {**plan, 'wide_search_stage': label, 'wide_source_open_width_m': float(width)}, arm, update, errors
+    return None, None, None, errors
+
+
+# ------------------------------------------------------------ table relocation
+# Public case outline (board frame) and the loose-piece table region per side.
+CASE_LOCAL_X = (-.0825, .1375)
+CASE_LOCAL_Y = (-.1575, .1575)
+SPOT_X = tuple(np.round(np.arange(.36, .741, .03), 3))
+SPOT_ABS_Y = tuple(np.round(np.arange(.21, .361, .03), 3))
+SPOT_PIECE_GAP_M = .050      # bead centre to any other bead centre
+SPOT_CASE_GAP_M = .030       # bead centre to the case outline
+PLACE_CLEARANCE_Z_M = .002   # release with the beads just above the table
+
+
+def _board_pose(scene, observed=None):
+    pose = (scene.get('board_for_planning') or {}).get('pose')
+    if pose is None:
+        pose = (scene.get('measurement') or {}).get('poses', {}).get('board')
+    if pose is None and observed is not None:
+        pose = observed['poses']['board']
+    return np.asarray(pose, float)
+
+
+def _poses_with(observed, scene, moved, target=None):
+    """Hypothetical observation/scene with some loose pieces translated, used
+    only to screen a destination; execution always re-observes and re-plans.
+    The planned target keeps its measured-pose role (no inflation of its own
+    beads); a moved neighbour gets the 4 mm placement inflation."""
+    from copy import deepcopy
+    obs = deepcopy(observed); sc = deepcopy(scene)
+    for name, pose in moved.items():
+        pose = [float(v) for v in pose]
+        obs['poses'][name] = pose
+        sc['measurement']['poses'][name] = pose
+        entry = {**sc['occupancy'][name], 'pose_hypotheses': [pose], 'hypothetical_relocation_destination': True}
+        if name != target:
+            entry.update(source='hypothetical_relocation_destination', inflation_m=.004)
+        sc['occupancy'][name] = entry
+    return obs, sc
+
+
+def _beads(name, pose):
+    pose = np.asarray(pose, float)
+    return model.local_beads(name) @ Rotation.from_quat(pose[3:]).as_matrix().T+pose[:3]
+
+
+# Public bench_075 table top (world x/y) and the margin every bead centre
+# keeps from its edge: a part put down past the near edge tips over.
+TABLE_X = (.3025, .8975)
+TABLE_Y = (-.65, .65)
+TABLE_EDGE_MARGIN_M = .020
+
+
+def _on_table(beads):
+    return bool(np.all(beads[:, 0] >= TABLE_X[0]+TABLE_EDGE_MARGIN_M) and np.all(beads[:, 0] <= TABLE_X[1]-TABLE_EDGE_MARGIN_M)
+                and np.all(beads[:, 1] >= TABLE_Y[0]+TABLE_EDGE_MARGIN_M) and np.all(beads[:, 1] <= TABLE_Y[1]-TABLE_EDGE_MARGIN_M))
+
+
+def _spot_free(name, pose, observed, scene):
+    beads = _beads(name, pose)
+    if not _on_table(beads):
+        return False
+    board = _board_pose(scene)
+    local = (beads-board[:3]) @ Rotation.from_quat(board[3:]).as_matrix()
+    dx = np.maximum(np.maximum(CASE_LOCAL_X[0]-local[:, 0], local[:, 0]-CASE_LOCAL_X[1]), 0.)
+    dy = np.maximum(np.maximum(CASE_LOCAL_Y[0]-local[:, 1], local[:, 1]-CASE_LOCAL_Y[1]), 0.)
+    if float(np.hypot(dx, dy).min()) < SPOT_CASE_GAP_M:
+        return False
+    for other, entry in scene['occupancy'].items():
+        if other == name:
+            continue
+        for hypothesis in entry['pose_hypotheses']:
+            if float(np.linalg.norm(beads[:, None]-_beads(other, hypothesis)[None], axis=2).min()) < SPOT_PIECE_GAP_M+entry.get('inflation_m', 0.):
+                return False
+    return True
+
+
+_VISIBILITY = {}
+
+
+def _fixed_view_masks():
+    """World-fixed cameras with the robot's projected silhouette at the home
+    posture (public robot CAD and the policy's own calibration). After a
+    table move the hands return home before the part is observed again."""
+    if 'views' not in _VISIBILITY:
+        views = []
+        try:
+            from . import vision
+            from .cyan_bimanual_adapter import _geometry
+            from .case_view_prediction import _robot_world_hulls, robot_occluder_mask
+            geometry = _geometry()
+            q16 = np.zeros(16)
+            for side, start in (('left', 0), ('right', 8)):
+                home = np.asarray(geometry.robot.iks[side]._home_q, float).ravel()
+                q16[start:start+6] = home[:6] if len(home) >= 6 else q16[start:start+6]
+            hulls = _robot_world_hulls(geometry, q16)
+            specs = vision.rig_specs()
+            for name, camera in vision.calibration(specs).items():
+                views.append((camera, robot_occluder_mask(camera, hulls, dilate_px=14)))
+        except Exception as error:  # no public robot geometry: no filter
+            _VISIBILITY['error'] = f'{type(error).__name__}: {error}'
+        _VISIBILITY['views'] = views
+    return _VISIBILITY['views']
+
+
+def _spot_visible(name, pose):
+    """Every bead projects inside the image and off the robot's home
+    silhouette in at least two world-fixed views (the official rig's single
+    gantry view when it has only one)."""
+    views = _fixed_view_masks()
+    if not views:
+        return True
+    beads = _beads(name, pose); clear = 0
+    for camera, mask in views:
+        uv = np.rint(camera.project(beads)).astype(int); h, w = mask.shape
+        depth = (beads-camera.camera_to_world[:3, 3]) @ camera.camera_to_world[:3, 2]
+        if (np.all(depth > 0) and np.all((uv[:, 0] >= 20) & (uv[:, 0] < w-20) & (uv[:, 1] >= 20) & (uv[:, 1] < h-20))
+                and not mask[uv[:, 1], uv[:, 0]].any()):
+            clear += 1
+    return clear >= min(2, len(views))
+
+
+# A put-down spot this close (horizontal) to the picking arm's base cramps
+# that arm: the tuned vertical grasp there did not track (scatter_1 Yellow at
+# 0.17 m: 16 mm / 0.04 rad off, fingers on the beads). Refused.
+SPOT_MIN_BASE_DISTANCE_M = .20
+
+
+def _base_clear(name, pose, arm):
+    centroid = _beads(name, np.asarray(pose, float)).mean(axis=0)
+    return float(np.linalg.norm(centroid[:2]-ARM_BASE_XY[int(arm)])) >= SPOT_MIN_BASE_DISTANCE_M
+
+
+def _spots(name, pose, arm, observed, scene):
+    pose = np.asarray(pose, float); sign = 1. if int(arm) == 0 else -1.
+    out = []
+    for x in SPOT_X:
+        for y in SPOT_ABS_Y:
+            moved = pose.copy(); moved[:2] = [x, sign*y]
+            # Same yaw; the piece's centroid lands on the grid point.
+            centroid = _beads(name, pose).mean(axis=0)
+            moved[:2] += pose[:2]-centroid[:2]
+            if _base_clear(name, moved, arm) and _spot_free(name, moved, observed, scene) and _spot_visible(name, moved):
+                out.append((float(np.linalg.norm(moved[:2]-pose[:2])), moved))
+    # Short carries first, toward the middle of the arm's loose-piece side.
+    comfort = np.array([.52, sign*.27])
+    out.sort(key=lambda row: .5*row[0]+float(np.linalg.norm(row[1][:2]-comfort)))
+    return [m for _, m in out]
+
+
+def _ik_ok(ctx, position, rotation, arm, reserve=.035):
+    plan = ctx.tool('puzzle.plan_pose', position=list(map(float, position)), rotation=rotation, arm_id=arm)
+    return (plan['position_error_m'] <= .002 and plan['rotation_error_rad'] <= .03
+            and plan.get('joint_limit_margin_rad', 1.) >= reserve), plan
+
+
+def _place_hand(pick, body, spot):
+    """Hand pose at the destination, holding the part with the pick's
+    hand-in-part transform (a turned spot turns the wrist with it)."""
+    T_b = _transform(body[:3], body[3:]); T_s = _transform(spot[:3], spot[3:])
+    T_h = _transform(pick['grasp'], c.qarr(pick['rotation']))
+    T = T_s @ np.linalg.inv(T_b) @ T_h
+    return T[:3, 3], c.qdict(Rotation.from_matrix(T[:3, :3]).as_quat())
+
+
+def _place_feasible(ctx, name, pick, body, spot, arm, p, scene):
+    from . import conditional_scene
+    hand_p, hand_q = _place_hand(pick, body, spot)
+    hand_p = hand_p+[0, 0, PLACE_CLEARANCE_Z_M]
+    for dz in (0., .030, .060):
+        ok, _ = _ik_ok(ctx, hand_p+[0, 0, dz], hand_q, arm)
+        if not ok:
+            return False, 'place_ik'
+    R = Rotation.from_quat(c.qarr(hand_q)).as_matrix()
+    board = _board_pose(scene)
+    width = float(p.get('source_open_width', .055))
+    for dz in np.linspace(0., .06, 4):
+        for w in np.linspace(.024, width, 4):
+            found = conditional_scene.hand_clearance(hand_p+[0, 0, dz], R, float(w), scene, exclude=(name,),
+                                                     plane_z=float(board[2]-.003))
+            if found['clearance_m'] < LIFT_MARGIN_M:
+                return False, 'place_hand_clearance'
+    return True, ''
+
+
+def _pick_plan(ctx, name, p, arm, observed, scene):
+    """A source-only grasp (hover/grasp IK, hand clearance) for moving a part
+    on the table; the target insertion is planned again after the move."""
+    for width in (float(p.get('source_open_width', .055)), .045, .035):
+        q = {**p, 'source_open_width': width, 'source_grasp_only': True, 'grasp_headings': FINE_HEADINGS,
+             'grasp_leans': [0., 30., -30., 45., -45.], 'grasp_auto': True, 'hand_clearance': True,
+             'grasp_heights': [.006, .014], 'source_hover': max(.055, float(p.get('source_hover', .055)))}
+        for key in ('grasp_indices', 'object_relative_grasp_se3', 'source_contact_grasp', 'grasp_pairs'):
+            q.pop(key, None)
+        try:
+            plan = screened_plan(ctx, name, q, arm, observed, scene)
+        except (c.PlanningRefusal, RuntimeError):
+            continue
+        ok, _ = _ik_ok(ctx, np.asarray(plan['grasp'])+[0, 0, .060], plan['rotation'], arm)
+        if ok:
+            return {**plan, 'source_open_width_m': width, 'source_hover_m': float(q['source_hover'])}
+    return None
+
+
+def _full_plan(ctx, name, p, arm_candidates, observed, scene, wide=True, state=None, tuned_only=False):
+    if p.get('geometry_module') and state is not None:
+        # A piece with its own geometry planner (Maroon) is screened by it.
+        from .modular_controller import load_skill_module
+        try:
+            return load_skill_module(p['geometry_module']).plan_from_rgb(
+                ctx, {**state, 'parameters': p, 'planning_scene': scene}, observed), arm_candidates[0]
+        except (c.PlanningRefusal, RuntimeError):
+            return None, None
+    mapped = profile_in_reference_frame(name, p, observed['poses'][name]) if name in observed.get('poses', {}) else None
+    fallback = {**p, **p['fallback_grasp_parameters']} if p.get('fallback_grasp_parameters') and not tuned_only else None
+    for q in (mapped, p, fallback):
+        if q is None:
+            continue
+        for arm in arm_candidates:
+            try:
+                found = c.plan(ctx, name, q, arm, observation=observed, planning_scene=scene)
+            except (c.PlanningRefusal, RuntimeError):
+                continue
+            if not untuned_grasp(name, q, found) or carry_prescreen(ctx, name, q, arm, found, observed, scene)[0]:
+                return found, arm
+    if not wide:
+        return None, None
+    plan, arm, _, _ = wide_source_plan(ctx, name, p, arm_candidates, observed, scene)
+    return plan, arm
+
+
+def _neighbour_parameters(p, other):
+    """The neighbour's own profile, planned in the target's conditional scene
+    (the scene's prefix and conditional-planning flags carry over)."""
+    from .modular_controller import profile_parameters
+    keep = ('conditional_planning', 'actual_executed_prefix', 'planning_prefix', 'given_prefix_names')
+    return {**profile_parameters(p, other), **{k: p[k] for k in keep if k in p}}
+
+
+def _neighbour_arm(body, free_arms):
+    arm = 0 if body[1] >= 0 else 1
+    return arm if arm in free_arms else (free_arms[0] if len(free_arms) == 1 else None)
+
+
+def plan_relocation(ctx, target, p, arm_candidates, observed, scene, profiles=None, max_spots=20, state=None, tuned_only=False, yaws=(),
+                    move_target=True, free_arms=(0, 1), turn_first=False):
+    """Choose one table move that makes the target plannable: the target to
+    a free spot where its full grasp/insertion plan passes, else one blocking
+    loose neighbour to a free spot that no longer blocks it. Each move has a
+    source-only pick, destination IK and an open-hand clearance screen.
+    ``move_target=False``: only neighbours move (the target stays where RGB
+    measured it); ``free_arms``: hands that may pick (a bracing hand never).
+    Returns a move dict or None (with the reasons tried)."""
+    tried = []; ctx = _PlanningCtx(ctx)
+    loose = [n for n, e in scene['occupancy'].items() if e['source'] in ('current_rgb_measurement',) and n != target]
+    body = np.asarray(observed['poses'][target], float)
+    arm = arm_candidates[0]
+    if move_target and arm not in free_arms:
+        move_target = False
+    pick = _pick_plan(ctx, target, p, arm, observed, scene) if move_target else None
+    if not move_target:
+        tried.append(dict(piece=target, refused='target_move_off'))
+    elif pick is not None:
+        spots = _spots(target, body, arm, observed, scene)[:max_spots]
+        if yaws:
+            # Only spots turned to a preferred yaw (see PREFERRED_YAW_BAND),
+            # turning in place first.
+            in_place = [t for t in (_with_yaw(target, body, yaw) for yaw in yaws)
+                        if _base_clear(target, t, arm) and _turn_in_place_free(target, body, t, scene) and _spot_visible(target, t)]
+            spots = in_place+[t for t in (_with_yaw(target, spot, yaw) for yaw in yaws for spot in spots)
+                              if _spot_free(target, t, observed, scene) and _spot_visible(target, t)]
+        elif tuned_only or turn_first:
+            # The profile's own grasp can fail at the source yaw everywhere
+            # (scatter_1 Yellow at 55 deg: none of 14 free spots) yet pass with
+            # the part turned: the same spots (and in place) turned in 30 deg
+            # steps, smallest turn first, each still free, visible and guarded.
+            R0 = Rotation.from_quat(body[3:]).as_matrix(); current = float(np.arctan2(R0[1, 0], R0[0, 0]))
+            base_spots = list(spots); turned = []
+            for turn in (30, -30, 60, -60, 90, -90, 120, -120, 150, -150, 180):
+                t = _with_yaw(target, body, current+np.radians(turn))
+                if _base_clear(target, t, arm) and _turn_in_place_free(target, body, t, scene) and _spot_visible(target, t):
+                    turned.append(t)
+                for spot in base_spots:
+                    t = _with_yaw(target, spot, current+np.radians(turn))
+                    if _base_clear(target, t, arm) and _spot_free(target, t, observed, scene) and _spot_visible(target, t):
+                        turned.append(t)
+            if turn_first:
+                # In-place turns first (smallest first), then the grid, then turned grid spots.
+                c0 = _beads(target, body).mean(axis=0)[:2]
+                here = lambda t: float(np.linalg.norm(_beads(target, t).mean(axis=0)[:2]-c0)) < .005
+                spots = [t for t in turned if here(t)]+base_spots+[t for t in turned if not here(t)]
+            else:
+                spots = base_spots+turned
+        # The profile's own grasp at every spot first, then the wide search
+        # at the best few.
+        for wide, candidates in ((False, spots),) if tuned_only else ((False, spots), (True, spots[:4])):
+            for spot in candidates:
+                ok, why = _place_feasible(ctx, target, pick, body, spot, arm, p, scene)
+                if not ok:
+                    tried.append(dict(piece=target, refused=why)); continue
+                obs_h, scene_h = _poses_with(observed, scene, {target: spot}, target=target)
+                plan, plan_arm = _full_plan(ctx, target, p, arm_candidates, obs_h, scene_h, wide=wide, state=state, tuned_only=tuned_only)
+                if plan is not None:
+                    return dict(piece=target, arm=arm, pick=pick, spot=spot.tolist(), body=body.tolist(),
+                                then_target_arm=plan_arm, tried=tried[-6:])
+                tried.append(dict(piece=target, refused='target_still_unplannable_at_spot'))
+    else:
+        tried.append(dict(piece=target, refused='no_source_only_pick'))
+    if yaws:
+        return dict(piece=None, tried=tried)
+    # A loose neighbour next to the target: move it out of the way.
+    tb = _beads(target, body)
+    near = sorted(((float(np.linalg.norm(tb[:, None]-_beads(n, observed['poses'][n])[None], axis=2).min()), n)
+                   for n in loose if n in observed['poses']))
+    for distance, other in near[:3]:
+        if distance > .09:
+            break
+        # Without that neighbour (moved far away), does the target plan?
+        obs_h, scene_h = _poses_with(observed, scene, {other: [9., 9., 9., 0., 0., 0., 1.]}, target=target)
+        plan, _ = _full_plan(ctx, target, p, arm_candidates, obs_h, scene_h, wide=not tuned_only, state=state, tuned_only=tuned_only)
+        if plan is None:
+            tried.append(dict(piece=other, refused='target_unplannable_even_without_it')); continue
+        other_body = np.asarray(observed['poses'][other], float)
+        other_arm = _neighbour_arm(other_body, free_arms)
+        if other_arm is None:
+            tried.append(dict(piece=other, refused='no_free_hand')); continue
+        op = _neighbour_parameters(p, other)
+        other_pick = _pick_plan(ctx, other, op, other_arm, observed, scene)
+        if other_pick is None:
+            tried.append(dict(piece=other, refused='no_source_only_pick')); continue
+        for spot in _spots(other, other_body, other_arm, observed, scene)[:max_spots]:
+            ok, why = _place_feasible(ctx, other, other_pick, other_body, spot, other_arm, op, scene)
+            if not ok:
+                tried.append(dict(piece=other, refused=why)); continue
+            obs_h, scene_h = _poses_with(observed, scene, {other: spot}, target=target)
+            plan, plan_arm = _full_plan(ctx, target, p, arm_candidates, obs_h, scene_h, wide=not tuned_only, state=state, tuned_only=tuned_only)
+            if plan is not None:
+                return dict(piece=other, arm=other_arm, pick=other_pick, spot=spot.tolist(), body=other_body.tolist(),
+                            then_target_arm=plan_arm, tried=tried[-6:], cleared_for=target)
+            tried.append(dict(piece=other, refused='target_still_unplannable'))
+    if tuned_only or yaws:
+        return dict(piece=None, tried=tried)
+    # A tight cluster (the target and its neighbours block each other): move
+    # the nearest neighbour that can be picked to a free spot away from the
+    # target, then observe and plan again (bounded by the caller).
+    for distance, other in near[:3]:
+        if distance > .06:
+            break
+        other_body = np.asarray(observed['poses'][other], float)
+        other_arm = _neighbour_arm(other_body, free_arms)
+        if other_arm is None:
+            continue
+        op = _neighbour_parameters(p, other)
+        other_pick = _pick_plan(ctx, other, op, other_arm, observed, scene)
+        if other_pick is None:
+            continue
+        for spot in _spots(other, other_body, other_arm, observed, scene)[:max_spots]:
+            if float(np.linalg.norm(_beads(other, spot)[:, None]-tb[None], axis=2).min()) < .10:
+                continue
+            ok, why = _place_feasible(ctx, other, other_pick, other_body, spot, other_arm, op, scene)
+            if ok:
+                return dict(piece=other, arm=other_arm, pick=other_pick, spot=spot.tolist(), body=other_body.tolist(),
+                            tried=tried[-6:], cleared_for=target, clearing_cluster=True)
+            tried.append(dict(piece=other, refused=why, clearing_cluster=True))
+    return dict(piece=None, tried=tried)
+
+
+def execute_relocation(ctx, move, p):
+    """Pick the part (screened lift), carry it at lift height on its own side,
+    lower it to just above the table at the chosen spot, open, withdraw."""
+    arm = int(move['arm']); pick = move['pick']; g = np.asarray(pick['grasp'], float); q = pick['rotation']
+    width = float(pick.get('source_open_width_m', p.get('source_open_width', .055)))
+    c.grip(ctx, arm, width)
+    c.move(ctx, g+[0, 0, float(pick.get('source_hover_m', max(.055, float(p.get('source_hover', .055)))))], q, arm)
+    c.move(ctx, g, q, arm, cartesian=True, contact='grasp')
+    c.grip(ctx, arm, float(p.get('close_width', 0.)))
+    state = dict(piece=move['piece'], plan=dict(body=move['body']), planning_scene=move.get('scene', {}))
+    offset, lift_record = screened_lift(ctx, state, arm, g, q, .060)
+    _put_down(ctx, arm, pick, np.asarray(move['body']), np.asarray(move['spot']), width)
+    return dict(lift=lift_record)
+
+
+def _put_down(ctx, arm, pick, body, spot, width):
+    """The place half of a table move: the hand above the spot holding the
+    part with the pick's hand-in-part transform, straight down to just above
+    the table, open, withdraw straight up, home."""
+    hand_p, hand_q = _place_hand(pick, body, spot)
+    hand_p = hand_p+[0, 0, PLACE_CLEARANCE_Z_M]
+    c.move(ctx, hand_p+[0, 0, .060], hand_q, arm)
+    c.move(ctx, hand_p, hand_q, arm, cartesian=True)
+    c.grip(ctx, arm, width)
+    tcp, tcp_q = c.hand(ctx, arm)
+    c.move(ctx, tcp+[0, 0, .060], tcp_q, arm, cartesian=True)
+    ctx.tool('robot.go_home', arm_id=arm)
+    ctx.tool('robot.wait_steps', steps=25)
+
+
+# Rule of thumb, not a geometric screen: Red source positions (body origin,
+# board frame) from which its official-rig hand-off has passed in 31 full runs
+# (sl* and officialcam*): world x 0.661-0.676, y -0.279..-0.260 with the case
+# at x ~0.465, yaw in the board frame -7.8..7.4 deg. A Red whose source plan
+# has no feasible candidate is staged there, turned to the board yaw.
+RED_STAGING_BOARD_X = (.192, .214)
+RED_STAGING_BOARD_Y = (-.280, -.258)
+
+
+def red_staging_spots(body, board):
+    """Red turned to the board yaw with its body origin on a grid inside the
+    staging box (centre first)."""
+    board = np.asarray(board, float); Rb = Rotation.from_quat(board[3:]).as_matrix()
+    yaw = float(np.arctan2(Rb[1, 0], Rb[0, 0]))
+    turned = _with_yaw('red', np.asarray(body, float), yaw)
+    centre = np.array([np.mean(RED_STAGING_BOARD_X), np.mean(RED_STAGING_BOARD_Y)])
+    grid = [np.array([x, y]) for x in np.linspace(*RED_STAGING_BOARD_X, 4) for y in np.linspace(*RED_STAGING_BOARD_Y, 4)]
+    out = []
+    for local in sorted(grid, key=lambda q: float(np.linalg.norm(q-centre))):
+        spot = turned.copy(); spot[:2] = board[:2]+Rb[:2, :2]@local; out.append(spot)
+    return out
+
+
+def plan_put_down(ctx, name, p, arm, plan, observed, scene):
+    """A screened free, observable table spot (0.20 m base guard) for a held
+    part, put down with the grasp it was picked with (the plan's hand-in-part
+    transform at its pregrasp source pose, same yaw). Planning only."""
+    ctx = _PlanningCtx(ctx); tried = []
+    body = np.asarray(plan['body'], float)
+    pick = dict(grasp=list(map(float, plan['grasp'])), rotation=plan['rotation'], index=plan.get('index'),
+                heading=plan.get('heading'), lean=plan.get('lean'))
+    for spot in _spots(name, body, arm, observed, scene):
+        ok, why = _place_feasible(ctx, name, pick, body, spot, arm, p, scene)
+        if ok:
+            return dict(spot=spot.tolist(), body=body.tolist(), pick=pick, arm=int(arm), tried=tried[-4:])
+        tried.append(dict(spot=[round(float(v), 3) for v in spot[:2]], refused=why))
+    return dict(spot=None, tried=tried[-6:])
+
+
+def execute_put_down(ctx, down, p):
+    _put_down(ctx, int(down['arm']), down['pick'], np.asarray(down['body']), np.asarray(down['spot']),
+              float(p.get('source_open_width', .055)))
+    return dict(put_down=True)
+
+
+def _with_yaw(name, pose, yaw):
+    """The same face-up pose turned about its bead centroid to world yaw."""
+    pose = np.asarray(pose, float); R = Rotation.from_quat(pose[3:]).as_matrix()
+    current = float(np.arctan2(R[1, 0], R[0, 0]))
+    turn = Rotation.from_euler('z', yaw-current)
+    centroid = _beads(name, pose).mean(axis=0)
+    out = pose.copy(); out[:3] = centroid+turn.apply(pose[:3]-centroid)
+    out[3:] = (turn*Rotation.from_quat(pose[3:])).as_quat()
+    return out
+
+
+def _turn_in_place_free(name, current, turned, scene):
+    """A turn in place keeps the part's own footprint: it must not come
+    closer to any other piece than it already is (and never within 28 mm)."""
+    before = _beads(name, current); after = _beads(name, turned)
+    if not _on_table(after):
+        return False
+    for other, entry in scene['occupancy'].items():
+        if other == name:
+            continue
+        for hypothesis in entry['pose_hypotheses']:
+            ob = _beads(other, hypothesis)
+            gap = float(np.linalg.norm(after[:, None]-ob[None], axis=2).min())
+            if gap < .028 or gap < float(np.linalg.norm(before[:, None]-ob[None], axis=2).min())-.002:
+                return False
+    return True
+
+
+def plan_module_relocation(ctx, name, p, arm, observed, scene, feasible, max_spots=20, yaws=(), max_shift_m=None, candidates=None):
+    """Table move for a piece whose own skill module plans its grasp (Cyan's
+    body-relative tip grasp): a generic source-only pick, then the first free
+    spot where `feasible(observed_h, scene_h, body_h)` passes. Planning only.
+    ``candidates``: explicit spots (poses) to try instead of the table grid;
+    each still needs a free, visible footprint, the screened put-down
+    (_place_feasible) and `feasible`."""
+    ctx = _PlanningCtx(ctx)
+    generic = {**p, 'source_open_width': .055, 'grasp_auto': True, 'hand_clearance': True, 'grasp_stability': True}
+    for key in ('source_contact_grasp', 'grasp_pairs', 'piece_module', 'geometry_module', 'object_relative_grasp_se3'):
+        generic.pop(key, None)
+    body = np.asarray(observed['poses'][name], float)
+    pick = _pick_plan(ctx, name, generic, arm, observed, scene)
+    if pick is None:
+        return dict(piece=None, tried=[dict(piece=name, refused='no_source_only_pick')])
+    tried = []
+    spots = _spots(name, body, arm, observed, scene)[:max_spots]
+    # Preferred orientations first (the yaw its downstream skill was tuned
+    # for), each still screened for a free table footprint.
+    if max_shift_m is not None:
+        # Stay near the original staging (the downstream hand-off paths were
+        # screened from there); a spot nearer the case cramped them.
+        spots = [spot for spot in spots if float(np.linalg.norm(np.asarray(spot[:2])-body[:2])) <= max_shift_m]
+    in_place = [_with_yaw(name, body, yaw) for yaw in yaws]
+    in_place = [spot for spot in in_place if _turn_in_place_free(name, body, spot, scene) and _spot_visible(name, spot)]
+    turned = [_with_yaw(name, spot, yaw) for yaw in yaws for spot in spots]
+    turned = [spot for spot in turned if _spot_free(name, spot, observed, scene) and _spot_visible(name, spot)]
+    order = [spot for spot in in_place+turned+([] if yaws else spots) if _base_clear(name, spot, arm)]
+    if candidates is not None:
+        order = []
+        for spot in candidates:
+            spot = np.asarray(spot, float)
+            if _base_clear(name, spot, arm) and _spot_free(name, spot, observed, scene) and _spot_visible(name, spot):
+                order.append(spot)
+            else:
+                tried.append(dict(piece=name, spot=spot[:2].tolist(), refused='spot_not_free_or_not_visible'))
+    for spot in order:
+        ok, why = _place_feasible(ctx, name, pick, body, spot, arm, generic, scene)
+        if not ok:
+            tried.append(dict(piece=name, refused=why)); continue
+        obs_h, scene_h = _poses_with(observed, scene, {name: spot}, target=name)
+        try:
+            feasible(obs_h, scene_h, np.asarray(spot, float))
+        except (c.PlanningRefusal, RuntimeError) as error:
+            tried.append(dict(piece=name, refused='module_plan_refused_at_spot', error=str(error)[-160:])); continue
+        return dict(piece=name, arm=arm, pick=pick, spot=spot.tolist(), body=body.tolist(), tried=tried[-6:],
+                    generic_parameters=dict(source_open_width=.055, source_hover=.055, close_width=0.))
+    return dict(piece=None, tried=tried[-6:])
+
+
+def untuned_grasp(name, p, plan):
+    """True when the chosen grasp is not the profile's own bead/heading/lean
+    (tuned grasps keep their original post-lift behaviour)."""
+    profile = (p.get('skill_profiles') or {}).get(name, {})
+    if plan.get('profile_grasp_in_reference_frame'):
+        return False
+    if p.get('geometry_module') or p.get('object_relative_grasp_se3') or p.get('source_contact_grasp') or not profile:
+        return False
+    def near(value, options):
+        return any(abs((float(value)-float(o)+180.) % 360.-180.) < 1e-6 for o in options)
+    beads = profile.get('grasp_indices')
+    if beads is not None and int(plan.get('index', -1)) not in [int(b) for b in beads]:
+        return True
+    if 'heading' in plan and not near(plan['heading'], profile.get('grasp_headings', [plan['heading']])):
+        return True
+    if 'lean' in plan and not near(plan['lean'], profile.get('grasp_leans', [plan['lean']])):
+        return True
+    return False
+
+
+# ------------------------------------------------------------ symmetric frames
+# A mirror-symmetric part has two equally valid CAD pose representations
+# (z up, or flipped with the bead set mapped onto itself). The RGB fit may
+# return either. The profiles' tuned grasps (bead index, jaw heading) were
+# written in one of them: the face-up frame, except Purple's, which was
+# tuned in its flipped frame. Re-expressing the tuned grasp in the observed
+# frame gives the same physical grasp.
+PROFILE_FRAME_Z_SIGN = {'purple': -1.}
+
+
+def _flip_symmetry(name):
+    local = model.local_beads(name)
+    for k in range(4):
+        S = model.rotation(k*np.pi/2) @ np.diag([1., -1., -1.])
+        d = np.linalg.norm((local @ S.T)[:, None]-local[None], axis=2)
+        if d.min(axis=1).max() < 1e-7:
+            return S, [int(j) for j in d.argmin(axis=1)]
+    return None, None
+
+
+def profile_in_reference_frame(name, p, body):
+    """The profile's tuned grasp re-expressed in the observed pose frame when
+    that frame is the other mirror representation; None otherwise."""
+    if p.get('geometry_module') or p.get('object_relative_grasp_se3') or not p.get('grasp_auto'):
+        return None
+    S, perm = _flip_symmetry(name)
+    if S is None:
+        return None
+    body = np.asarray(body, float); R = Rotation.from_quat(body[3:]).as_matrix()
+    if R[2, 2]*PROFILE_FRAME_Z_SIGN.get(name, 1.) > 0:
+        return None
+    reference = R @ S
+    yaw = lambda M: float(np.degrees(Rotation.from_matrix(M).as_euler('xyz')[2]))
+    shift = yaw(reference)-yaw(R)
+    q = {**p, 'grasp_headings': [float((h+shift) % 360.) for h in p.get('grasp_headings', [90.])],
+         'profile_grasp_reference_frame': 'mirror representation of the observed pose'}
+    if 'grasp_indices' in p:
+        q['grasp_indices'] = [perm[int(i)] for i in p['grasp_indices']]
+    return q
+
+
+# Board-frame source yaw (deg) inside which the piece's downstream hand-off
+# skill completed in native runs. Red, the last piece, finished from -4.6 to
+# +7.0 deg; from -6.6 to -8.1 deg five of seven runs stopped in its hand-off
+# or goal phases. Outside the band the (then empty) table is used to turn it.
+PREFERRED_YAW_BAND = {'red': (-6., 7.5)}
+
+
+def yaw_preference(name, body, board):
+    band = PREFERRED_YAW_BAND.get(name)
+    if band is None:
+        return None
+    R = Rotation.from_quat(np.asarray(body, float)[3:]).as_matrix()
+    Rb = Rotation.from_quat(np.asarray(board, float)[3:]).as_matrix()
+    yaw = float(np.degrees((np.arctan2(R[1, 0], R[0, 0])-np.arctan2(Rb[1, 0], Rb[0, 0])+np.pi) % (2*np.pi)-np.pi))
+    if band[0] <= yaw <= band[1]:
+        return None
+    return dict(yaw_in_board_deg=yaw, band_deg=list(band), target_world_yaw=float(np.arctan2(Rb[1, 0], Rb[0, 0])))
+
+
+# ------------------------------------------------------------ carry pre-screen
+def carry_prescreen(ctx, name, p, arm, plan, observed, scene):
+    """Before a grasp is accepted: the held carry from the lifted grasp to the
+    board-frame hover above the goal must exist as the transport node will
+    look for it (plan_joint_path: endpoint IK seeded from the lifted posture,
+    joint reserve >= the profile's reserve along the joint line), for at
+    least one public-CAD-equivalent target frame. Public robot model only;
+    returns (passed, record). Pieces with their own transport are skipped."""
+    if p.get('piece_module') or p.get('transport_module') or p.get('geometry_module'):
+        return True, dict(skipped='own transport module')
+    try:
+        from .cyan_bimanual_adapter import _geometry
+        geometry = _geometry()
+        side = 'left' if int(arm) == 0 else 'right'; ik = geometry.robot.iks[side]
+        packet = ctx.tool('robot.read_proprioception', arm_id=arm)
+        seed = np.asarray(packet['robot_encoder_values'], float)[:16].copy()
+    except Exception as error:  # no public model: no pre-screen
+        return True, dict(skipped=f'{type(error).__name__}: {error}')
+    reserve = float(p.get('min_ik_joint_margin_rad', .035))
+    lower = ik.model.joint_limit_lower.numpy()[ik.arm_dofs]; upper = ik.model.joint_limit_upper.numpy()[ik.arm_dofs]
+    coords = list(ik.arm_coords)
+
+    def solve(start, position, quaternion):
+        sol = np.asarray(ik.solve_q_full(start.copy(), np.asarray(position, float), np.asarray(quaternion, float)), float)
+        pe, re = ik.pose_errors(sol, np.asarray(position, float), np.asarray(quaternion, float))
+        return sol, float(pe), float(re)
+    body = np.asarray(plan['body'], float); R = Rotation.from_quat(body[3:]).as_matrix()
+    grasp = np.asarray(plan['grasp'], float); hand_R = Rotation.from_quat(c.qarr(plan['rotation'])).as_matrix()
+    rel_p = hand_R.T @ (body[:3]-grasp); rel_R = hand_R.T @ R
+    lift = grasp+[0, 0, float(p.get('lift', .085))]
+    # The lifted posture the executed move will reach: the native IK tool's
+    # own answer for the lift pose (same seeds and cache as the grasp move).
+    native = ctx.tool('puzzle.plan_pose', position=lift.tolist(), rotation=plan['rotation'], arm_id=arm)
+    if native['position_error_m'] > .002 or native['rotation_error_rad'] > .03:
+        return False, dict(refused='lift IK', position_error_m=native['position_error_m'])
+    lifted = seed.copy(); lifted[coords] = np.asarray(native['joints'], float)
+    home = seed.copy(); home[coords] = np.asarray(ik._home_q, float).ravel()[:len(coords)]
+    board = _board_pose(scene, observed); Rb = Rotation.from_quat(board[3:]).as_matrix()
+    target = board[:3]+Rb @ np.asarray(plan['target_center'], float)
+    local = model.local_beads(name); frames = [np.asarray(plan['target_R'], float)]
+    from .vision_observer import goals
+    public_R = np.asarray(goals(p.get('mode', 'pyramid'), p.get('pyramid_plan', 'pyramid_robot6_plan.json'))[name][1])
+    for k in range(4):
+        for flip in (False, True):
+            S = model.rotation(k*np.pi/2) @ (np.diag([1., -1., -1.]) if flip else np.eye(3))
+            if np.linalg.norm((local @ S.T)[:, None]-local[None], axis=2).min(axis=1).max() < 1e-7:
+                candidate = public_R @ S
+                if not any(np.allclose(candidate, f) for f in frames):
+                    frames.append(candidate)
+    refusals = []
+    for frame in frames:
+        goal_hand = Rb @ frame @ rel_R.T
+        tcp = target-goal_hand @ rel_p
+        endpoint = tcp+Rb[:, 2]*float(p.get('transport', .1))
+        q = Rotation.from_matrix(goal_hand).as_quat()
+        # Like the native tool: the best of the live (lifted) and home seeds,
+        # preferring solutions that keep the reserve.
+        best = None
+        for start in (lifted, home):
+            end, pe, re = solve(start, endpoint, q)
+            margin = float(np.minimum(end[coords]-lower, upper-end[coords]).min())
+            cost = pe+.05*re+(1. if margin < reserve else 0.)
+            if best is None or cost < best[0]:
+                best = (cost, end, pe, re)
+        _, end, pe, re = best
+        if pe > .002 or re > .03:
+            refusals.append(dict(frame='equivalent', refused='endpoint IK', position_error_m=pe)); continue
+        a = lifted[coords]; b = end[coords]
+        margins = [float(np.minimum(a+(b-a)*u-lower, upper-(a+(b-a)*u)).min())
+                   for u in np.linspace(0., 1., max(2, int(np.ceil(np.max(np.abs(b-a))/.020)))+1)]
+        if min(margins) < reserve:
+            refusals.append(dict(refused='joint reserve along the carry', min_margin_rad=min(margins))); continue
+        return True, dict(min_margin_rad=min(margins), frames_tried=len(refusals)+1)
+    return False, dict(refusals=refusals[-3:])
