+def random_palette(seed):
+    """Scene only: one uniform random colour per piece ('random' or 'random<seed>').
+
+    Hue is uniform; saturation and value stay in the range of the original
+    plastic colours (S >= .7, V >= .45), so a piece is never neutral grey
+    like the robot and table or as dark as the case. Nothing keeps two pieces
+    apart in colour: near-identical pairs are part of the distribution.
+    """
+    import colorsys
+    rng=np.random.default_rng(seed+7919)
+    return {n:tuple(float(c) for c in colorsys.hsv_to_rgb(float(rng.uniform()),float(rng.uniform(.7,1.)),float(rng.uniform(.45,1.))))
+            for n in m.CELLS}
