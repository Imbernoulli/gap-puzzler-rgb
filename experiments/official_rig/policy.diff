+"""Wrist-camera survey poses for the official YAM station rig.
+
+At the home posture each wrist D405 looks past its own fingertips toward the far
+table edge, so most loose pieces are seen by the gantry camera alone. Multi-view
+acceptance therefore needs an explicit look: each free hand lifts its wrist
+camera over its own side of the table, looking down at that side's loose pieces
+and the case. The poses are fixed public geometry (table and case regions from
+the task layout); no object estimate chooses them.
+"""
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+from .vision import wrist_mount
+
+# Camera eye and look-at point per side [m, RSS world]. Image x runs along the
+# table's long (world x) axis, the D405's 89 deg horizontal field.
+SURVEY_CAMERAS = {
+    'left': dict(eye=(.47, .20, 1.25), look_at=(.47, .12, .75)),
+    'right': dict(eye=(.47, -.20, 1.25), look_at=(.47, -.12, .75)),
+}
+
+
+def look_at(eye, target, up):
+    eye = np.asarray(eye, float); forward = np.asarray(target, float)-eye; forward /= np.linalg.norm(forward)
+    right = np.cross(forward, np.asarray(up, float)); right /= np.linalg.norm(right)
+    down = np.cross(forward, right)
+    T = np.eye(4); T[:3, 0] = right; T[:3, 1] = down; T[:3, 2] = forward; T[:3, 3] = eye
+    return T
+
+
+def camera_target(side, spec=None):
+    spec = spec or SURVEY_CAMERAS[side]
+    # Image "up" toward the arm's own outer side keeps the wrist roll near home.
+    up = (0., 1., 0.) if side == 'left' else (0., -1., 0.)
+    return look_at(spec['eye'], spec['look_at'], spec.get('up', up))
+
+
+def tcp_target(side, ik, spec=None):
+    """TCP position and xyzw quaternion that put this side's wrist camera at its survey pose."""
+    offset = np.eye(4)
+    offset[:3, :3] = Rotation.from_quat(np.asarray(ik.ee_offset_rot, float)).as_matrix()
+    offset[:3, 3] = np.asarray(ik.ee_offset, float)
+    tcp = camera_target(side, spec) @ np.linalg.inv(wrist_mount()) @ offset
+    return tcp[:3, 3], Rotation.from_matrix(tcp[:3, :3]).as_quat()
+
+
+# ---------------------------------------------------------------- active look
+import json
+from functools import lru_cache
+from pathlib import Path
+
+from . import model as _model
+from .vision import D405
+
+LOOK_TARGET_UV = (640., 240.)  # above the fingertips, which fill the lower image
+
+
+@lru_cache(maxsize=1)
+def looks():
+    return json.loads((Path(__file__).with_name('survey_looks.json')).read_text())
+
+
+def _K():
+    fy = .5*D405['height']/np.tan(np.radians(D405['fov_y'])/2)
+    return np.array([[fy, 0, D405['width']/2], [0, fy, D405['height']/2], [0, 0, 1.]])
+
+
+def choose_look(proposal, exclude=(), side=None):
+    """The precomputed wrist look that best centres an RGB proposal's beads.
+
+    ``proposal`` is an RGB identity proposal (optimizer seed), never a measured
+    pose. Returns (arm_id, side, joints, score) or None.
+    """
+    p = np.asarray(proposal, float)
+    side = side or ('left' if p[1] >= 0 else 'right')
+    K = _K(); best = None
+    for look in looks()[side]['looks']:
+        if list(look['joints']) in [list(j) for j in exclude]:
+            continue
+        C = np.asarray(look['camera_to_world'])
+        pc = (p[:3]-C[:3, 3]) @ C[:3, :3]
+        if pc[2] <= .05:
+            continue
+        uv = (K @ pc)[:2]/pc[2]
+        score = float(np.hypot(uv[0]-LOOK_TARGET_UV[0], uv[1]-LOOK_TARGET_UV[1]))
+        if best is None or score < best[3]:
+            best = (0 if side == 'left' else 1, side, look['joints'], score)
+    return best
+
+
+def _screened_look(ctx, arm, joints, *, scene=None, target=None):
+    """Move ``arm`` to precomputed look ``joints``; returns (motion or None, refusal or None).
+
+    With an attributed planning scene the path is screened (free_arm_motion: a
+    low or bracing hand retreats straight up first). Without one, only a hand
+    at or above the free-move height moves, along the original joint line (the
+    precomputed looks are laid out from such postures); a low hand is refused.
+    A refusal moves nothing.
+    """
+    from . import vision_controller as c
+    from . import free_arm_motion as fam
+    if scene is not None:
+        try:
+            return fam.move_to(ctx, arm, joints, scene=scene, target=target), None
+        except fam.FreeArmRefusal as error:
+            return None, str(error)[:300]
+    packet = ctx.tool('robot.read_proprioception', arm_id=arm)
+    if float(packet['tcp'][2]) < fam.FREE_MOVE_SAFE_Z_M:
+        return None, 'free hand below the free-move height and no planning scene to screen its retreat'
+    side = 'left' if arm == 0 else 'right'
+    current = [float(packet['robot_encoder_values'][i]) for i in looks()[side]['arm_coords']]
+    if np.max(np.abs(np.asarray(current)-np.asarray(joints))) > 1.e-3:
+        c.feed_joint_plan(ctx, {'current': current, 'joints': list(joints)}, arm)
+    return dict(arm=arm, unscreened_from_free_move_height=True), None
+
+
+def _return_home(ctx, arm, motion):
+    from . import free_arm_motion as fam
+    if motion is not None and motion.get('segments'):
+        return fam.go_home(ctx, motion)
+    return ctx.tool('robot.go_home', arm_id=arm)
+
+
+def look_and_observe(ctx, names, hints=None, max_looks=2, always=True, *, scene=None, scene_fn=None, sweep=True, arms=(0, 1),
+                     escalate=False):
+    """Observe; then aim the free wrist camera on the target's side at the target
+    (its RGB fit or, when refused, its gantry identity proposal) and observe again.
+
+    ``always``: look even when the home frame already accepted the target. At
+    home a wrist camera sees only the far table edge past its fingertips, and a
+    fit supported there is poorly conditioned (3.8 deg tilt seen on Cyan); the
+    inward look is the measurement the planner uses. The arm stays at the look
+    posture (the planner starts from encoders).
+
+    ``scene`` (or ``scene_fn(observed)``) is the attributed planning scene the
+    look path is screened against (_screened_look).
+
+    ``escalate``: when the looks on the target's side give it no fit, the
+    looking hand returns home and the other free hand's best look is tried,
+    then the free hands survey the loose-piece areas (SWEEP_ROUNDS) until the
+    target is fitted.
+    """
+    from . import vision_controller as c
+    observed = c.state(ctx, hints) if hints else c.state(ctx)
+    record = []; tried = []; carried = {}; swept = False; frames = []; motions = []
+    def carry(frame):
+        # Gantry identity proposals of earlier frames in this call stay
+        # available as inflated obstacle hypotheses (never measured poses);
+        # the earlier frames themselves are returned for the RGB history.
+        carried.update(gantry_proposals(frame))
+        frame['gantry_proposals'] = {k: v for k, v in carried.items() if k not in frame.get('poses', {})}
+        frames.append(frame)
+        return frame
+    observed = carry(observed)
+    for attempt in range(max_looks+2):
+        missing = [n for n in names if n not in observed.get('poses', {})]
+        if always and attempt == 0 and not missing:
+            missing = list(names[:1])
+        if not missing or len(tried) >= max_looks:
+            break
+        detection = observed.get('detections', {}).get(missing[0], {})
+        # Aim at the current identity proposal, else at the caller's hint (an
+        # earlier RGB fit or proposal of the part, or a planned table spot).
+        proposal = detection.get('identity_proposal') or detection.get('pose') or (hints or {}).get(missing[0])
+        if proposal is None and not swept and sweep:
+            # No identity yet (e.g. a bead hidden behind an arm at home). Lift
+            # both wrist cameras to their side surveys; this also clears the
+            # arms from the gantry view. Then aim at the target as usual.
+            swept = True
+            if scene is None and scene_fn is not None:
+                try:
+                    scene = scene_fn(observed)
+                except Exception as error:  # no attributed scene from this frame
+                    record.append(dict(scene_refusal=f'{type(error).__name__}: {str(error)[:200]}'))
+                    scene_fn = None
+            observed, rows = side_sweep(ctx, hints, scene=scene, arms=arms)
+            observed = carry(observed)
+            found = observed.get('poses', {}).get(missing[0]) or observed.get('detections', {}).get(missing[0], {}).get('identity_proposal')
+            if found is not None:
+                # Only the target's side keeps its look; the other hand returns home.
+                sweep_home(ctx, rows, arms=(1 if found[1] >= 0 else 0,))
+                motions.extend((row['arm'], row['motion']) for row in rows
+                               if row.get('motion') is not None and row['arm'] == (0 if found[1] >= 0 else 1))
+            else:
+                motions.extend((row['arm'], row['motion']) for row in rows if row.get('motion') is not None)
+            record.append(dict(piece=missing[0], side_sweep=[{k: v for k, v in row.items() if k != "motion"} for row in rows], accepted=missing[0] in observed.get('poses', {}),
+                               proposal=found is not None))
+            continue
+        if proposal is None:
+            record.append(dict(piece=missing[0], refused='no RGB proposal to aim a wrist camera'))
+            break
+        chosen = choose_look(proposal, exclude=tried)
+        if chosen is None:
+            record.append(dict(piece=missing[0], refused='no precomputed look sees the proposal'))
+            break
+        arm, side, joints, score = chosen
+        if arm not in arms:
+            # That hand is not free (e.g. it braces the case).
+            record.append(dict(piece=missing[0], arm=arm, refused='the looking hand is not free'))
+            break
+        tried.append(list(joints))
+        if scene is None and scene_fn is not None:
+            try:
+                scene = scene_fn(observed)
+            except Exception as error:  # no attributed scene from this frame
+                record.append(dict(scene_refusal=f'{type(error).__name__}: {str(error)[:200]}'))
+                scene_fn = None
+        motion, refusal = _screened_look(ctx, arm, joints, scene=scene, target=(missing[0], list(proposal)))
+        if motion is None:
+            record.append(dict(piece=missing[0], arm=arm, look_joints=list(joints), refused=refusal))
+            continue
+        motions.append((arm, motion))
+        ctx.tool('robot.wait_steps', steps=20)
+        observed = carry(c.state(ctx, hints) if hints else c.state(ctx))
+        record.append(dict(piece=missing[0], arm=arm, look_joints=list(joints), centring_px=score,
+                           accepted=missing[0] in observed.get('poses', {})))
+    target = names[0] if names else None
+    if escalate and target is not None and target not in observed.get('poses', {}):
+        observed = _escalate_look(ctx, target, observed, hints, carried, scene, scene_fn, sweep, arms, record, motions, carry,
+                                  first_round=1 if swept else 0)
+    observed['wrist_looks'] = record
+    observed['_look_motions'] = motions  # for a caller that returns the looking hand home
+    observed['look_frames'] = [{k: f[k] for k in ('poses', 'detections', 'timestamp', 'frame_sha256', 'observation_source',
+                                                  'robot_geometry_provenance', 'bounded_rgb_source') if k in f}
+                               for f in frames[:-1]]
+    return observed
+
+
+def _escalate_look(ctx, target, observed, hints, carried, scene, scene_fn, sweep, arms, record, motions, carry, first_round=0):
+    """The target's side looks gave no fit (look_and_observe(escalate=True)):
+    every hand that looked returns home, the other free hand's best look at
+    the latest proposal is tried, then the free hands survey the loose-piece
+    areas round by round until the target is fitted. Returns the last frame."""
+    from . import vision_controller as c
+    def observe():
+        ctx.tool('robot.wait_steps', steps=20)
+        return carry(c.state(ctx, hints) if hints else c.state(ctx))
+    def home_all():
+        while motions:
+            arm, motion = motions.pop()
+            _return_home(ctx, arm, motion)
+    if scene is None and scene_fn is not None:
+        try:
+            scene = scene_fn(observed)
+        except Exception as error:
+            record.append(dict(scene_refusal=f'{type(error).__name__}: {str(error)[:200]}'))
+    detection = observed.get('detections', {}).get(target, {})
+    proposal = detection.get('identity_proposal') or detection.get('pose') or carried.get(target) or (hints or {}).get(target)
+    looked_arms = {row.get('arm') for row in record if row.get('piece') == target and 'look_joints' in row}
+    if proposal is not None:
+        for side in ('left', 'right'):
+            arm = 0 if side == 'left' else 1
+            if arm not in arms or arm in looked_arms:
+                continue
+            chosen = choose_look(proposal, side=side)
+            if chosen is None:
+                continue
+            home_all()
+            motion, refusal = _screened_look(ctx, arm, chosen[2], scene=scene, target=(target, list(proposal)))
+            if motion is None:
+                record.append(dict(piece=target, arm=arm, look_joints=list(chosen[2]), escalation='other_arm', refused=refusal))
+                continue
+            motions.append((arm, motion))
+            observed = observe()
+            record.append(dict(piece=target, arm=arm, look_joints=list(chosen[2]), centring_px=chosen[3], escalation='other_arm',
+                               accepted=target in observed.get('poses', {})))
+            if target in observed.get('poses', {}):
+                return observed
+    if not sweep:
+        return observed
+    for number, targets in list(enumerate(SWEEP_ROUNDS))[first_round:]:
+        home_all()
+        observed, rows = side_sweep(ctx, hints, scene=scene, targets=targets, arms=arms)
+        motions.extend((row['arm'], row['motion']) for row in rows if row.get('motion') is not None)
+        observed = carry(observed)
+        accepted = target in observed.get('poses', {})
+        record.append(dict(piece=target, escalation=f'side_sweep_{number}', side_sweep=[{k: v for k, v in row.items() if k != 'motion'} for row in rows],
+                           accepted=accepted))
+        if accepted:
+            found = observed['poses'][target]
+            keep = 0 if found[1] >= 0 else 1
+            for arm, motion in [m for m in motions if m[0] != keep]:
+                _return_home(ctx, arm, motion)
+            motions[:] = [m for m in motions if m[0] == keep]
+            return observed
+    return observed
+
+
+SWEEP_TARGETS = {'left': (.44, .29), 'right': (.44, -.29)}
+# Successive surveys of the loose-piece areas (fixed public table points):
+# the middle of each side, then next to the arm bases, then the far end.
+SWEEP_ROUNDS = (SWEEP_TARGETS, {'left': (.32, .33), 'right': (.32, -.33)}, {'left': (.68, .29), 'right': (.68, -.29)})
+
+
+def side_sweep(ctx, hints=None, scene=None, targets=None, arms=(0, 1)):
+    """Both free wrist cameras to the precomputed look nearest their side's
+    loose-piece region, one synchronous three-camera frame. Fixed public
+    geometry chooses the looks; no object estimate does. Each move is the
+    screened look motion (_screened_look); a refused move sends nothing.
+    ``targets``: one of SWEEP_ROUNDS (default the first); ``arms``: the free
+    hands (a bracing hand never moves)."""
+    from . import vision_controller as c
+    sweep = []
+    for side, target in (targets or SWEEP_TARGETS).items():
+        arm = 0 if side == 'left' else 1
+        if arm not in arms:
+            continue
+        candidates = looks()[side]['looks']
+        look = min(candidates, key=lambda l: np.hypot(l['target'][0]-target[0], l['target'][1]-target[1]))
+        motion, refusal = _screened_look(ctx, arm, look['joints'], scene=scene)
+        sweep.append(dict(arm=arm, look_target=list(look['target']), motion=motion, refused=refusal))
+    ctx.tool('robot.wait_steps', steps=20)
+    return (c.state(ctx, hints) if hints else c.state(ctx)), sweep
+
+
+def sweep_home(ctx, sweep, arms=(0, 1)):
+    for row in sweep:
+        if row['arm'] in arms and row.get('motion') is not None:
+            _return_home(ctx, row['arm'], row['motion'])
+
+
+GANTRY_PROPOSAL_INFLATION_M = .006
+
+
+def gantry_obstacle(item, *sources):
+    found = gantry_obstacle_source(item, *sources)
+    return None if found is None else found[0]
+
+
+def gantry_proposals(observed):
+    """This frame's gantry-view identity proposals {name: pose}, or those it carries."""
+    out = dict((observed or {}).get('gantry_proposals', {}))
+    for name, detection in (observed or {}).get('detections', {}).items():
+        proposal = detection.get('identity_proposal') if isinstance(detection, dict) else None
+        if proposal is not None and 'top' in detection.get('views', []):
+            out[name] = [float(v) for v in proposal]
+    return out
+
+
+def gantry_obstacle_source(item, *sources):
+    """Latest gantry-view CAD identity proposal for a loose piece, as an obstacle.
+
+    Official rig: a loose piece no wrist camera has looked at has only the
+    gantry view, whose fit is refused (one view). Its identity proposal in a
+    frame where the gantry view had its silhouette is an inflated collision
+    hypothesis for planning only; it never becomes a measured pose.
+    """
+    for source in sources:
+        rows = source if isinstance(source, (list, tuple)) else [source]
+        for row in reversed(rows):
+            proposal = gantry_proposals(row).get(item)
+            if proposal is None:
+                continue
+            proposal = np.asarray(proposal, dtype=float)
+            if proposal.shape == (7,) and np.isfinite(proposal).all():
+                return proposal.tolist(), row
+    return None
+
+
+# ------------------------------------------------------------ held-piece look
+# The wrist D405 sees its own fingertips across the lower image; a held piece
+# must project above them, clear of the image border.
+HELD_LOOK_MARGIN_PX = 80.
+HELD_LOOK_MAX_V_PX = 450.
+
+
+def choose_held_look(points, side):
+    """The precomputed look of the arm on ``side`` that frames ``points``.
+
+    ``points`` are the predicted bead centres of a piece held by the *other*
+    arm (accepted pre-grasp RGB pose moved by the commanded lift; a seed, not a
+    measurement). Every bead must project in front of the camera, inside the
+    image margin and above the own-fingertip band. Returns (joints, score) or None.
+    """
+    points = np.asarray(points, float)
+    K = _K(); best = None
+    for look in looks()[side]['looks']:
+        C = np.asarray(look['camera_to_world'])
+        pc = (points-C[:3, 3]) @ C[:3, :3]
+        if np.any(pc[:, 2] <= .15):
+            continue
+        uv = (pc @ K.T)[:, :2]/pc[:, 2:3]
+        if (uv[:, 0].min() < HELD_LOOK_MARGIN_PX or uv[:, 0].max() > D405['width']-HELD_LOOK_MARGIN_PX
+                or uv[:, 1].min() < HELD_LOOK_MARGIN_PX or uv[:, 1].max() > HELD_LOOK_MAX_V_PX):
+            continue
+        centre = uv.mean(axis=0)
+        score = float(np.hypot(centre[0]-LOOK_TARGET_UV[0], centre[1]-LOOK_TARGET_UV[1]))
+        if best is None or score < best[1]:
+            best = (look['joints'], score)
+    return best
+
+
+def _frames_points(C, points):
+    """Pixel coordinates of world points in a vision-basis camera pose, or None if any is unusable."""
+    K = _K()
+    pc = (np.asarray(points, float)-C[:3, 3]) @ C[:3, :3]
+    if np.any(pc[:, 2] <= .15):
+        return None
+    uv = (pc @ K.T)[:, :2]/pc[:, 2:3]
+    if (uv[:, 0].min() < HELD_LOOK_MARGIN_PX or uv[:, 0].max() > D405['width']-HELD_LOOK_MARGIN_PX
+            or uv[:, 1].min() < HELD_LOOK_MARGIN_PX or uv[:, 1].max() > HELD_LOOK_MAX_V_PX):
+        return None
+    return uv
+
+
+def held_camera_candidates(points, side, max_turn_deg=40.):
+    """Wrist-camera poses of the free arm that centre a held piece.
+
+    Each candidate keeps the eye of a precomputed survey look (a reachable
+    camera position for that arm) and re-aims the optical axis at the piece,
+    keeping the look's image-up direction so the wrist roll stays close. The
+    turn from the survey orientation is bounded; every bead must frame above
+    the own-fingertip band. Sorted nearest first.
+    """
+    points = np.asarray(points, float)
+    centre = points.mean(axis=0)
+    out = []
+    for look in looks()[side]['looks']:
+        C0 = np.asarray(look['camera_to_world'], float)
+        eye = C0[:3, 3]
+        C = look_at(eye, centre-np.array([0., 0., .03]), -C0[:3, 1])
+        turn = float(np.degrees(Rotation.from_matrix(C0[:3, :3].T @ C[:3, :3]).magnitude()))
+        if turn > max_turn_deg:
+            continue
+        uv = _frames_points(C, points)
+        if uv is None:
+            continue
+        out.append((C, float(np.linalg.norm(centre-eye)), dict(survey_target=look['target'], turn_deg=turn)))
+    return sorted(out, key=lambda row: row[1])
+
+
+def look_at_held(ctx, name, prediction, holding_arm, reference=None, *, scene=None, holder_beads=(),
+                 anchor_evidence=None, envelope_m=.008):
+    """Aim the free arm's wrist camera at a held piece, observe, return the arm home.
+
+    Official rig: after a lift the held piece is seen by the gantry and, past
+    the jaws, by its own wrist camera; bead-level two-view support usually
+    fails. The free arm's wrist camera gives the second independent view the
+    four-camera rig had. Robot motion only; the returned observation is plain
+    current RGB (the prediction is an optimizer seed).
+
+    Every free-arm motion is screened (free_arm_motion): a low or bracing hand
+    retreats straight up first, the look and the return home are full public
+    robot/scene-guarded paths with the held part and the holder's ``holder_beads``
+    contact. Without a ``scene``, or with no screened path, nothing moves and the
+    caller keeps its non-look path.
+    """
+    from . import vision_controller as c
+    from . import free_arm_motion as fam
+    free = 1-int(holding_arm); side = 'left' if free == 0 else 'right'
+    prediction = np.asarray(prediction, float)
+    points = _model.local_beads(name) @ Rotation.from_quat(prediction[3:]).as_matrix().T+prediction[:3]
+    record = dict(piece=name, free_arm=free)
+    # Calibrated flange-to-camera transform of the free arm, from the latest
+    # synchronous capture (camera_to_world) and the arm's encoder FK TCP; the
+    # arm has not moved since that capture.
+    if reference is None:
+        reference = c.state(ctx, {name: prediction.tolist()})
+    if name in reference.get('poses', {}):
+        return reference, {**record, 'measured_before_look': True}
+    tcp, tcp_q = c.hand(ctx, free)
+    T_tcp = np.eye(4); T_tcp[:3, :3] = Rotation.from_quat(c.qarr(tcp_q)).as_matrix(); T_tcp[:3, 3] = tcp
+    camera = np.asarray(reference['robot_geometry_provenance']['camera_to_world'][side+'_wrist'], float)
+    tcp_to_camera = np.linalg.inv(T_tcp) @ camera
+    if scene is None:
+        return reference, {**record, 'refused': 'no planning scene to screen a free-arm look'}
+    held = fam.held_part(ctx, name, prediction, holding_arm, holder_beads, envelope_m)
+    holder, _ = c.hand(ctx, holding_arm)
+    moved = None; motion = None; refusals = []
+    for C, score, spec in held_camera_candidates(points, side)[:6]:
+        T = C @ np.linalg.inv(tcp_to_camera)
+        if np.linalg.norm(T[:3, 3]-holder) < .20 or T[2, 3] < .87:
+            continue
+        q = c.qdict(Rotation.from_matrix(T[:3, :3]).as_quat())
+        plan = ctx.tool('puzzle.plan_pose', position=T[:3, 3].tolist(), rotation=q, arm_id=free, min_joint_limit_margin_rad=.035)
+        if plan['position_error_m'] > .002 or plan['rotation_error_rad'] > .03 or plan['joint_limit_margin_rad'] < .035:
+            continue
+        try:
+            motion = fam.move_to(ctx, free, plan['joints'], scene=scene, held=held, anchor_evidence=anchor_evidence)
+        except fam.FreeArmRefusal as error:
+            refusals.append(str(error)[:300])
+            continue
+        moved = dict(kind='computed_held_look', camera_distance_m=score, **spec)
+        break
+    if moved is None:
+        chosen = choose_held_look(points, side)
+        if chosen is None:
+            return reference, {**record, 'refused': 'no free-arm look frames the held piece', 'screen_refusals': refusals}
+        joints, score = chosen
+        try:
+            motion = fam.move_to(ctx, free, joints, scene=scene, held=held, anchor_evidence=anchor_evidence)
+        except fam.FreeArmRefusal as error:
+            return reference, {**record, 'refused': 'no screened free-arm look path',
+                               'screen_refusals': [*refusals, str(error)[:300]]}
+        moved = dict(kind='precomputed_survey_look', centring_px=score, look_joints=list(joints))
+    ctx.tool('robot.wait_steps', steps=20)
+    observed = c.state(ctx, {name: prediction.tolist()})
+    home = fam.go_home(ctx, motion)
+    return observed, {**record, **moved, 'accepted': name in observed.get('poses', {}), 'home_result': home,
+                      'screened_motion': dict(retreat=motion['retreat'], move_guard=motion['move_guard'],
+                                              brace_exit=motion.get('brace_exit'), replans=motion.get('replans')),
+                      'screen_refusals': refusals}
+
+
+def look_release_pair(ctx, name, hint, pause_steps=50, *, scene=None):
+    """Released-piece RGB pair taken from a wrist look at the piece's goal.
+
+    With both hands home only the gantry sees the case, so a release pair
+    never has two supported views. The arm on the goal's side aims its wrist
+    camera at the public goal pose (look choice only; the fit is seeded by it,
+    never filled with it), both frames are taken from that posture, then the
+    arm returns home. Returns (first, second, tcp_by_arm_at_pair, record);
+    ``first`` is None when no precomputed look sees the goal.
+    """
+    from . import vision_controller as c
+    chosen = choose_look(hint[name])
+    if chosen is None:
+        return None, None, None, dict(piece=name, refused='no precomputed look sees the goal')
+    arm, side, joints, score = chosen
+    motion, refusal = _screened_look(ctx, arm, joints, scene=scene, target=(name, list(hint[name])))
+    if motion is None:
+        return None, None, None, dict(piece=name, refused='no screened look path: '+str(refusal))
+    ctx.tool('robot.wait_steps', steps=pause_steps)
+    first = c.state(ctx, hint)
+    ctx.tool('robot.wait_steps', steps=pause_steps)
+    second = c.state(ctx, {**hint, name: first['poses'][name]} if name in first.get('poses', {}) else hint)
+    tcps = {a: c.hand(ctx, a)[0] for a in (0, 1)}
+    home = _return_home(ctx, arm, motion)
+    return first, second, tcps, dict(piece=name, look_arm=arm, look_joints=list(joints), centring_px=score,
+                                     home_result=home)
+
+
+# ------------------------------------------------------- neighbour framing look
+# A loose neighbour whose beads come this close to the target's beads can
+# block the jaws; its occupancy then decides which grasps are feasible.
+NEIGHBOUR_BEAD_GAP_M = .05
+UNMEASURED_SOURCES = ('current_gantry_single_view_rgb_proposal', 'conditional_recent_unplaced_rgb_persistence')
+
+
+def _bead_points(name, pose):
+    pose = np.asarray(pose, float)
+    return _model.local_beads(name) @ Rotation.from_quat(pose[3:]).as_matrix().T+pose[:3]
+
+
+def finger_reach_m(open_width, band_m=2*_model.RADIUS):
+    """Largest distance from the TCP approach axis of the public finger
+    colliders (public hand MJCF, gripper_geometry) at a commanded jaw opening,
+    over the colliders' parts within ``band_m`` above the TCP: the part of the
+    open hand that reaches the layer of beads lying beside a grasped bead."""
+    from .gripper_geometry import hand_primitives
+    t = np.linspace(-1., 1., 21)
+    reach = 0.
+    for shape in hand_primitives(float(open_width)):
+        if not any(key in shape.name.split(':')[0] for key in ('_lf_', '_rf_')):
+            continue
+        c, A, size = np.asarray(shape.center, float), np.asarray(shape.rotation, float), np.asarray(shape.size, float)
+        if shape.kind == 'capsule':
+            points = c+t[:, None]*size[1]*A[:, 2]; pad = size[0]
+        elif shape.kind == 'sphere':
+            points = c[None]; pad = size[0]
+        else:
+            grid = np.array([[x, y, z] for x in t[::5] for y in t[::5] for z in t[::5]])
+            points = c+(grid*size) @ A.T; pad = 0.
+        # TCP +z points from the wrist toward the fingertips.
+        points = points[points[:, 2]+pad >= -band_m]
+        if len(points):
+            reach = max(reach, float(np.linalg.norm(points[:, :2], axis=1).max())+float(pad))
+    return reach
+
+
+def unmeasured_neighbours(target, observed, scene, open_width=None):
+    """Loose pieces next to the target whose planning occupancy is not a current
+    two-view measurement (an inflated gantry proposal or dated RGB), nearest first.
+
+    Near means a neighbour bead centre within NEIGHBOUR_BEAD_GAP_M of a target
+    bead or, with ``open_width``, within reach of the open fingers of a grasp on
+    a target bead: finger reach (public hand CAD) + bead radius + that
+    neighbour's own planning inflation. An inflated hypothesis inside that
+    reach can refuse the tuned grasp a measurement would admit.
+    """
+    if target not in observed.get('poses', {}):
+        return []
+    mine = _bead_points(target, observed['poses'][target])
+    reach = None if open_width is None else finger_reach_m(open_width)
+    out = []
+    for name, item in scene.get('occupancy', {}).items():
+        if name == target or item.get('source') not in UNMEASURED_SOURCES:
+            continue
+        gap = min(float(np.linalg.norm(_bead_points(name, h)[:, None]-mine[None], axis=2).min())
+                  for h in item['pose_hypotheses'])
+        limit = NEIGHBOUR_BEAD_GAP_M if reach is None else max(
+            NEIGHBOUR_BEAD_GAP_M, reach+_model.RADIUS+float(item.get('inflation_m', 0.)))
+        if gap < limit:
+            out.append((gap, name, list(item['pose_hypotheses'][0])))
+    return [(name, pose) for _, name, pose in sorted(out, key=lambda row: row[0])]
+
+
+def choose_framing_look(items, exclude=()):
+    """Precomputed look on the first item's side that frames every bead of every
+    item above the own-fingertip band; least worst-case offset from the aim point."""
+    side = 'left' if float(items[0][1][1]) >= 0 else 'right'
+    points = np.concatenate([_bead_points(n, p) for n, p in items])
+    K = _K(); best = None
+    for look in looks()[side]['looks']:
+        if list(look['joints']) in [list(j) for j in exclude]:
+            continue
+        C = np.asarray(look['camera_to_world'])
+        pc = (points-C[:3, 3]) @ C[:3, :3]
+        if np.any(pc[:, 2] <= .05):
+            continue
+        uv = (pc @ K.T)[:, :2]/pc[:, 2:3]
+        if (uv[:, 0].min() < HELD_LOOK_MARGIN_PX or uv[:, 0].max() > D405['width']-HELD_LOOK_MARGIN_PX
+                or uv[:, 1].min() < 40. or uv[:, 1].max() > HELD_LOOK_MAX_V_PX):
+            continue
+        score = float(np.max(np.hypot(uv[:, 0]-LOOK_TARGET_UV[0], uv[:, 1]-LOOK_TARGET_UV[1])))
+        if best is None or score < best[3]:
+            best = (0 if side == 'left' else 1, side, look['joints'], score)
+    return best
+
+
+def look_at_neighbours(ctx, target, observed, neighbours, *, scene=None):
+    """Aim the target-side (still free) wrist camera so the target and its
+    unmeasured neighbours are all in view, and observe once more. The new frame
+    is returned only if it still measures the target and measures at least one
+    more neighbour; otherwise the caller keeps its frame."""
+    from . import vision_controller as c
+    record = dict(piece=target, neighbours=[n for n, _ in neighbours])
+    # Frame the target with all its unmeasured neighbours; failing that, with
+    # the nearest ones only (neighbours arrive nearest first).
+    for count in range(len(neighbours), 0, -1):
+        chosen = choose_framing_look([(target, observed['poses'][target]), *neighbours[:count]])
+        if chosen is not None:
+            neighbours = neighbours[:count]
+            break
+    else:
+        return None, {**record, 'refused': 'no precomputed look frames the target with its neighbours'}
+    record['framed_neighbours'] = [n for n, _ in neighbours]
+    arm, side, joints, score = chosen
+    motion, refusal = _screened_look(ctx, arm, joints, scene=scene, target=(target, list(observed['poses'][target])))
+    if motion is None:
+        return None, {**record, 'refused': 'no screened look path: '+str(refusal)}
+    ctx.tool('robot.wait_steps', steps=20)
+    new = c.state(ctx)
+    gained = [n for n, _ in neighbours if n in new.get('poses', {})]
+    record.update(arm=arm, look_joints=list(joints), worst_offset_px=score, target_measured=target in new.get('poses', {}),
+                  measured_neighbours=gained)
+    if target not in new.get('poses', {}) or not gained:
+        return None, record
+    return new, record
+
+
+# ------------------------------------------------------- completion looks
+def _planned_visible(C, K, points, width=D405['width'], height=D405['height'], patch=2):
+    """Planned goal bead sites a camera at C would see, by the same in-frame and
+    planned-bead occlusion test as assembly_completion.evaluate."""
+    origin = C[:3, 3]; offsets = points-origin
+    distance = np.linalg.norm(offsets, axis=1); direction = offsets/distance[:, None]
+    local = offsets @ C[:3, :3]
+    seen = []
+    for i in range(len(points)):
+        if local[i, 2] <= .05:
+            continue
+        u, v = (K @ local[i])[:2]/local[i, 2]
+        if not (patch <= u < width-patch and patch <= v < height-patch):
+            continue
+        along = offsets @ direction[i]
+        perpendicular = np.linalg.norm(offsets-along[:, None]*direction[i], axis=1)
+        if ((np.arange(len(points)) != i) & (along < distance[i]) & (perpendicular < _model.RADIUS+.001)).any():
+            continue
+        seen.append(i)
+    return set(seen)
+
+
+def completion_looks(board_pose, targets, fixed_cameras, per_side=2, wanted_views=3):
+    """Wrist looks that best complete the fixed cameras' view of the planned pyramid.
+
+    The completed pyramid's bead sites come from the RGB case pose and the public
+    plan (no object estimate). Greedy next-best-view over the precomputed looks:
+    first pieces no camera would see yet, then planned site views for pieces
+    seen fewer than ``wanted_views`` times (redundancy from a new direction);
+    at most ``per_side`` looks per arm. Returns [(arm_id, side, joints, target, new_pieces)].
+    """
+    from .assembly_completion import planned_sites
+    sites = planned_sites(board_pose, targets)
+    points = np.array([p for _, p in sites]); names = [n for n, _ in sites]
+    counts = {name: 0 for name in names}
+    for camera in fixed_cameras.values():
+        for i in _planned_visible(camera.camera_to_world, camera.K, points):
+            counts[names[i]] += 1
+    K = _K(); options = []
+    for side in ('left', 'right'):
+        for look in looks()[side]['looks']:
+            seen = {}
+            for i in _planned_visible(np.asarray(look['camera_to_world']), K, points):
+                seen[names[i]] = seen.get(names[i], 0)+1
+            options.append((side, look, seen))
+    chosen = []; used = {'left': 0, 'right': 0}
+    while True:
+        best = None
+        for side, look, seen in options:
+            if used[side] >= per_side or any(look is row[1] for row in chosen):
+                continue
+            new = sorted(n for n in seen if counts[n] == 0)
+            gain = sum(min(counts[n]+k, wanted_views)-min(counts[n], wanted_views) for n, k in seen.items())
+            score = (len(new), gain, sum(seen.values()))
+            if gain > 0 and (best is None or score > best[0]):
+                best = (score, side, look, seen, new)
+        if best is None:
+            break
+        score, side, look, seen, new = best
+        chosen.append((side, look, new))
+        for n, k in seen.items():
+            counts[n] += k
+        used[side] += 1
+    return [(0 if side == 'left' else 1, side, list(look['joints']), list(look['target']), new)
+            for side, look, new in chosen]
+
+
+def completion_survey(ctx, per_side=2, wanted_views=3, *, scene_fn=None):
+    """Whole-pyramid completion looks: the home frame (gantry plus both wrists),
+    then each chosen wrist look with the other arm at home. Every frame runs the
+    unchanged per-frame completion test; each looking arm returns home after its
+    frame. Returns (frames, plan)."""
+    hint = {'__completion_check__': True}
+    home = ctx.tool('vision.observe', hints=hint)
+    frames = [home]
+    board = home.get('poses', {}).get('board')
+    if board is None:
+        return frames, dict(refused='case not fitted in the home frame; no look can be planned')
+    from .vision import FIXED_VIEWS, calibration, rig_specs
+    fixed = calibration([s for s in rig_specs() if s.name in FIXED_VIEWS])
+    from .vision_observer import goals
+    targets = goals('pyramid', 'pyramid_robot6_plan.json')
+    plan = completion_looks(board, targets, fixed, per_side=per_side, wanted_views=wanted_views)
+    executed = []; scene = None; scene_refusal = None
+    if scene_fn is not None:
+        try:
+            scene = scene_fn(home)
+        except Exception as error:  # no attributed scene: home-posture looks only
+            scene_refusal = f'{type(error).__name__}: {str(error)[:200]}'
+    for arm, side, joints, target, new in plan:
+        motion, refusal = _screened_look(ctx, arm, joints, scene=scene)
+        if motion is None:
+            executed.append(dict(arm=arm, look_target=target, look_joints=joints, refused=refusal))
+            continue
+        ctx.tool('robot.wait_steps', steps=20)
+        frames.append(ctx.tool('vision.observe', hints=hint))
+        _return_home(ctx, arm, motion)
+        executed.append(dict(arm=arm, look_target=target, look_joints=joints, planned_new_pieces=new,
+                             timestamp=frames[-1]['timestamp']))
+    return frames, dict(looks=executed, scene_refusal=scene_refusal,
+                        source='RGB case pose of the home frame, public plan and robot model')
