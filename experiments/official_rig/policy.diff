+def _texture_image(appearance,name,seed,size=512):
+    """Scene only: the diffuse map (linear RGB in [0, 1]) of one piece.
+
+    wood: one oak grain (growth rings along the piece's long axis, fine
+    streaks, a little figure), stained per piece with its own hue.
+    wood_natural: the same untinted oak on every piece.
+    speckle: a per-piece base hue with a granite-like 1-2 mm speckle of
+    lighter, darker and hue-shifted grains over about a third of the surface.
+    speckle_soft: the same speckle with gentler grains (11 degree hue shift).
+    """
+    import colorsys
+    rng=np.random.default_rng(seed*1000+sorted(m.CELLS).index(name)+17)
+    if appearance in ('wood','wood_natural'):
+        grain=np.random.default_rng(31)  # the same oak on every piece
+        x=np.arange(size)/size
+        warp=1.5*_value_noise((size,size),grain,6)+.4*_value_noise((size,size),grain,24)
+        # 40 growth rings across the 150 mm map: a 3.75 mm period, so a 25 mm
+        # bead shows six or seven dark latewood lines on lighter earlywood.
+        phase=(40*x[None,:]+warp)%1.
+        latewood=np.exp(-((phase-.5)/.09)**2)
+        streak=_value_noise((size,size),grain,160)-.5
+        figure=_value_noise((size,size),grain,8)-.5
+        shade=1.12-.62*latewood+.16*streak+.08*figure
+        oak=np.asarray(OAK) if appearance=='wood' else np.asarray((.80,.42,.16))  # natural: warmer, more saturated
+        img=oak[None,None,:]*shade[...,None]
+        if appearance=='wood':
+            hues=(np.arange(12)/12.+np.random.default_rng(seed+5003).uniform(-.02,.02,12))%1.
+            order=np.random.default_rng(seed+5009).permutation(12)
+            h=float(hues[order[sorted(m.CELLS).index(name)]])
+            stain=np.asarray(colorsys.hsv_to_rgb(h,.75,1.))
+            img=img*(.40+.60*stain)[None,None,:]
+        return np.clip(img,0.,1.)
+    h=float(rng.uniform());base=np.asarray(colorsys.hsv_to_rgb(h,float(rng.uniform(.7,1.)),float(rng.uniform(.55,.95))))
+    img=np.repeat(np.repeat(base[None,None,:],size,0),size,1)
+    cell=4  # texels per speckle grain (about 1.2 mm on a 150 mm map)
+    grains=rng.random((size//cell,size//cell))
+    kind=np.kron(np.digitize(grains,[.12,.24,.34]),np.ones((cell,cell),int))  # 0 light, 1 dark, 2 hue-shifted, 3 base
+    soft=appearance=='speckle_soft'  # gentler grains: lighter/darker by ~20-30%, hue shifted by 11 deg
+    img[kind==0]=np.clip(base*(1.2 if soft else 1.35)+(.03 if soft else .08),0,1)
+    img[kind==1]=base*(.7 if soft else .55)
+    shifted=np.asarray(colorsys.hsv_to_rgb((h+(.03 if soft else .08))%1.,.8,float(base.max())))
+    img[kind==2]=shifted
+    return np.clip(img,0.,1.)
+
