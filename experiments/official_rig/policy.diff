index 0000000..43c6e1e
--- /dev/null
+++ b/b/puzzler/source_age_recovery.py
@@ -0,0 +1,259 @@
+"""Bounded recovery when an owned RGB source outlives its declared age scope.
+
+The native simulator keeps stepping while the policy computes. On a slow or
+contended host a planning pass (e.g. a widened grasp search) can therefore age
+an owned source past its declared scope although nothing in the scene changed:
+the pregrasp RGB source of a conditional attachment (<= 20 s at close), the
+attachment itself (<= 30 s after close), a measured held source (<= 30 s) or
+the historical RGB reference of a release (<= ``historical_max_age_s``).
+
+Such a refusal says nothing about the scene; a fresh look does. Every limit and
+gate stays unchanged: a new RGB packet is taken now (with a free-wrist look
+where the view needs one, the holding hand still), it must reproduce the dated
+source or measure the held part, and only then is the same owned-source tool
+called on it. Fresh evidence that fails a gate refuses exactly as before.
+"""
+from copy import deepcopy
+
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+from . import vision_controller as c
+from .vision_stages import StageRefusal
+
+# Refresh a planned pregrasp source older than this before the grasp motion
+# starts; the attachment's own 20 s scope is untouched.
+REFRESH_BEFORE_GRASP_S = 8.
+# A fresh fit must reproduce the dated source the plan was computed from.
+SOURCE_MATCH_M = .002
+# Fresh-look attempts per step.
+MAX_ATTEMPTS = 2
+AGE_SCOPE_TEXTS = ('outside declared scope', 'Conditional attachment expired', 'bounded30s',
+                   'exceeds bounded age scope')
+
+
+def is_age_scope_refusal(error):
+    text = str(error)
+    return any(key in text for key in AGE_SCOPE_TEXTS)
+
+
+def _now(ctx, arm):
+    return float(ctx.tool('robot.read_proprioception', arm_id=arm)['timestamp'])
+
+
+def _displacement(name, a, b):
+    from .visual_memory import shape_displacement
+    return float(shape_displacement(name, a, b))
+
+
+def _fresh_loose(ctx, name, pose, *, look):
+    """A new accepted RGB packet of a loose part, with one free-wrist look if needed."""
+    fresh = c.state(ctx, {name: list(pose)})
+    looks = None
+    if name not in fresh.get('poses', {}) and look:
+        from .survey import look_and_observe
+        fresh = look_and_observe(ctx, [name], hints={name: list(pose)}, max_looks=1, always=False)
+        looks = fresh.get('wrist_looks')
+    return fresh, looks
+
+
+def refresh_planned_source(ctx, state, arm):
+    """Before the grasp motion: replace an aged planned source by a fresh packet
+    that reproduces it (<= SOURCE_MATCH_M). Otherwise keep the dated source
+    unchanged (the original behaviour) and record why."""
+    from .modular_controller import save_observation
+    name = state['piece']; origin = state['observation']
+    age = _now(ctx, arm)-float(origin['timestamp'])
+    record = dict(kind='planned_source_age_refresh', piece=name, dated_source_timestamp=origin['timestamp'],
+                  dated_source_age_s=age, refresh_after_s=REFRESH_BEFORE_GRASP_S, match_limit_m=SOURCE_MATCH_M)
+    if age <= REFRESH_BEFORE_GRASP_S:
+        return state, {**record, 'refreshed': False}
+    pose = origin['poses'][name]
+    for attempt in range(MAX_ATTEMPTS):
+        fresh, looks = _fresh_loose(ctx, name, pose, look=attempt == 0)
+        record.setdefault('attempts', []).append(dict(timestamp=fresh.get('timestamp'), measured=name in fresh.get('poses', {}),
+                                                      wrist_looks=looks))
+        if name not in fresh.get('poses', {}):
+            continue
+        moved = _displacement(name, pose, fresh['poses'][name])
+        record['attempts'][-1]['displacement_from_dated_source_m'] = moved
+        if moved > SOURCE_MATCH_M:
+            # The part is not where the plan saw it: never re-date the plan.
+            return state, {**record, 'refreshed': False, 'refused': 'fresh RGB does not reproduce the dated source'}
+        state = save_observation(state, fresh)
+        return state, {**record, 'refreshed': True, 'fresh_source_timestamp': fresh['timestamp']}
+    return state, {**record, 'refreshed': False, 'refused': 'fresh RGB does not measure the part'}
+
+
+def reauthenticate_attachment(ctx, state, arm, assumption, error):
+    """After the close, before the lift: an attachment refused only for its source
+    age is captured again from a fresh packet of the closed-jaw part (holder
+    still; the free wrist looks if the frame lacks support). The fresh pose
+    must lie within the attachment's own declared displacement bound of the
+    dated source. Returns (state, attachment or None, record)."""
+    from .modular_controller import save_observation
+    from .survey import look_at_held
+    name = state['piece']
+    record = dict(kind='attachment_source_age_reauthentication', piece=name, original_refusal=str(error))
+    if not is_age_scope_refusal(error):
+        return state, None, {**record, 'skipped': 'refusal is not an age scope'}
+    dated = state['observation']['poses'][name]
+    bound = float(assumption.get('bead_displacement_bound_m', .008))
+    for attempt in range(MAX_ATTEMPTS):
+        fresh = c.state(ctx, {name: list(dated)}); look = None
+        if name not in fresh.get('poses', {}):
+            fresh, look = look_at_held(ctx, name, np.asarray(dated, float), arm, reference=fresh)
+        row = dict(timestamp=fresh.get('timestamp'), measured=name in fresh.get('poses', {}), free_wrist_look=look)
+        record.setdefault('attempts', []).append(row)
+        if name not in fresh.get('poses', {}):
+            continue
+        row['displacement_from_dated_source_m'] = moved = _displacement(name, dated, fresh['poses'][name])
+        if moved > bound:
+            return state, None, {**record, 'refused': 'fresh closed-jaw RGB exceeds the declared attachment bound'}
+        state = save_observation(state, fresh)
+        source = dict(piece=name, pose=fresh['poses'][name], timestamp=fresh['timestamp'], frame_sha256=fresh['frame_sha256'],
+                      observation_source=fresh['observation_source'],
+                      role='Actual closed-jaw pre-lift RGB (age-scope reauthentication); not a postlift held measurement')
+        try:
+            attachment = ctx.tool('puzzle.capture_conditional_attachment', source_rgb=source, assumption=assumption, arm_id=arm)
+        except ValueError as second:
+            row['capture_refusal'] = str(second)
+            if not is_age_scope_refusal(second):
+                return state, None, record
+            continue
+        return state, attachment, {**record, 'reauthenticated': True, 'attachment_id': attachment['attachment_id']}
+    return state, None, record
+
+
+def _held_prediction(ctx, state, arm):
+    """Aim point for a free-wrist look at the held part: current FK x the owned
+    relative transform (aim only, never a measurement)."""
+    p = state['parameters']; name = state['piece']
+    tcp = ctx.tool('robot.read_proprioception', arm_id=arm)['tcp']
+    R = Rotation.from_quat(tcp[3:]).as_matrix()
+    attachment = state.get('conditional_attachment') or {}
+    if 'object_in_tcp_position' in attachment:
+        rel_p = np.asarray(attachment['object_in_tcp_position'], float); rel_R = np.asarray(attachment['object_in_tcp_rotation'], float)
+        return np.r_[np.asarray(tcp[:3]) + R@rel_p, Rotation.from_matrix(R@rel_R).as_quat()]
+    source = p.get('owned_held_belief_source') or {}
+    if 'pose' in source:
+        return np.asarray(source['pose'], float)
+    return np.asarray(state.get('prediction') or state['plan']['body'], float)
+
+
+def owned_held_belief(ctx, state, refresh_after_s=None):
+    """Propagate the owned held estimate. When only its age scope refuses it,
+    measure the held part now with the free wrist camera (holder still) and
+    continue from that accepted current RGB/q16 source. With
+    ``refresh_after_s`` (carry start, where the held part is still clear of the
+    case) a valid estimate older than that is renewed the same way, keeping
+    the valid one if the look does not measure the part. Returns (state, belief, record)."""
+    from .modular_controller import save_observation
+    from .survey import look_at_held
+    p = state['parameters']; arm = state['arm']; name = state['piece']
+    try:
+        if p.get('conditional_attachment_id'):
+            belief = ctx.tool('puzzle.propagate_conditional_attachment', attachment_id=p['conditional_attachment_id'], arm_id=arm)
+        else:
+            belief = ctx.tool('puzzle.propagate_pyramid_held_belief', source=p['owned_held_belief_source'], arm_id=arm)
+        if refresh_after_s is None or float(belief.get('source_age_s', 0.)) <= refresh_after_s:
+            return state, belief, None
+        valid = belief
+        record = dict(kind='held_source_age_renewal', piece=name, source_age_s=float(belief['source_age_s']),
+                      renew_after_s=refresh_after_s)
+    except ValueError as error:
+        if not is_age_scope_refusal(error):
+            raise
+        valid = None
+        record = dict(kind='held_source_age_remeasurement', piece=name, original_refusal=str(error))
+    for attempt in range(MAX_ATTEMPTS):
+        prediction = _held_prediction(ctx, state, arm)
+        fresh = c.state(ctx, {name: prediction.tolist()}); look = None
+        if name not in fresh.get('poses', {}):
+            fresh, look = look_at_held(ctx, name, prediction, arm, reference=fresh)
+        row = dict(timestamp=fresh.get('timestamp'), measured=name in fresh.get('poses', {}), free_wrist_look=look)
+        record.setdefault('attempts', []).append(row)
+        if name not in fresh.get('poses', {}):
+            continue
+        tcp, _ = c.hand(ctx, arm)
+        gap = c.part_hand_gap(name, fresh['poses'][name], tcp); row['hand_bead_gap_m'] = gap
+        if gap > .045:
+            raise StageRefusal('Current RGB contradicts the retained grasp (held part away from the hand)')
+        q16 = fresh['robot_geometry_provenance']
+        source = dict(mode='pyramid', piece=name, pose=fresh['poses'][name], timestamp=fresh['timestamp'], frame_sha256=fresh['frame_sha256'],
+                      observation_source=fresh['observation_source'], robot_encoder_values=q16['robot_encoder_values'],
+                      robot_encoder_sha256=q16['robot_encoder_sha256'], source_step=q16['step'],
+                      source_role='Actual accepted current held RGB and synchronous robot q16 (age-scope remeasurement)')
+        p = {**p, 'owned_held_belief_source': source}; p.pop('conditional_attachment_id', None)
+        state = {**save_observation(state, fresh), 'parameters': p}
+        belief = ctx.tool('puzzle.propagate_pyramid_held_belief', source=source, arm_id=arm)
+        return state, belief, {**record, 'remeasured': True, 'source_timestamp': source['timestamp']}
+    if valid is not None:
+        return state, valid, {**record, 'renewed': False}
+    raise StageRefusal('Held estimate outlived its declared age scope and a fresh look did not measure the held part: '
+                       + str(record['original_refusal']))
+
+
+def refresh_historical_reference(ctx, state):
+    """Release planning: when the grasp-time historical RGB reference has used
+    two thirds of its age limit, the newest owned accepted packet that has the
+    case becomes the reference (same limit); the record list is the current
+    RGB history. A fresh host never reaches this."""
+    p = state['parameters']; history = state.get('rgb_history', [])
+    old = p.get('historical_complete_rgb')
+    if old is None:
+        return state, None
+    limit = float(p.get('historical_max_age_s', 15.))
+    if _now(ctx, state['arm'])-float(old.get('timestamp', 0.)) <= 2*limit/3:
+        return state, None
+    newest = next((row for row in reversed(history) if 'board' in row.get('poses', {})), None)
+    if newest is None or float(newest['timestamp']) <= float(old.get('timestamp', -1.)):
+        return state, None
+    p = {**p, 'historical_complete_rgb': {k: deepcopy(newest[k]) for k in ('poses', 'timestamp', 'frame_sha256', 'observation_source') if k in newest},
+         'historical_rgb_records': deepcopy(history)}
+    return {**state, 'parameters': p}, dict(kind='historical_reference_refresh', previous_timestamp=old.get('timestamp'),
+                                            reference_timestamp=newest['timestamp'])
+
+
+def refresh_stale_observation(ctx, state, limit_s=30.):
+    """Carry planning: when the last accepted packet has used two thirds of the
+    carry's board-source limit, take a fresh one (held part seeded by its owned
+    prediction) so the carry is planned from current RGB."""
+    from .modular_controller import save_observation
+    arm = state['arm']; name = state['piece']
+    age = _now(ctx, arm)-float(state['observation']['timestamp'])
+    if age <= 2*limit_s/3:
+        return state, None
+    hints = {name: _held_prediction(ctx, state, arm).tolist()}
+    fresh = c.state(ctx, hints); look = None
+    if 'board' not in fresh.get('poses', {}):
+        fresh, look = _free_wrist_case_look(ctx, state, arm, hints)
+    record = dict(kind='stale_observation_refresh', age_s=age, case_look=look)
+    if 'board' not in fresh.get('poses', {}):
+        return state, {**record, 'adopted': False, 'reason': 'fresh packets lack the case'}
+    return save_observation(state, fresh), {**record, 'adopted': True, 'timestamp': fresh['timestamp']}
+
+
+def _free_wrist_case_look(ctx, state, holder, hints):
+    """The free hand carries its wrist camera to the precomputed survey look of
+    its own side that best centres the case (aimed at the dated RGB case pose;
+    aim only), observes with the gantry and both wrists, and returns home. The
+    holding hand does not move."""
+    from .survey import choose_look, looks
+    free = 1-int(holder); side = 'left' if free == 0 else 'right'
+    board = (state['observation'].get('poses', {}).get('board')
+             or next((row['poses']['board'] for row in reversed(state.get('rgb_history', [])) if 'board' in row.get('poses', {})), None))
+    if board is None:
+        return c.state(ctx, hints), dict(refused='no dated case pose to aim at')
+    chosen = choose_look(board, side=side)
+    if chosen is None:
+        return c.state(ctx, hints), dict(refused='no survey look of the free arm sees the case')
+    _, _, joints, score = chosen
+    packet = ctx.tool('robot.read_proprioception', arm_id=free)
+    current = [float(packet['robot_encoder_values'][i]) for i in looks()[side]['arm_coords']]
+    c.feed_joint_plan(ctx, {'current': current, 'joints': list(joints)}, free)
+    ctx.tool('robot.wait_steps', steps=20)
+    fresh = c.state(ctx, hints)
+    home = ctx.tool('robot.go_home', arm_id=free)
+    return fresh, dict(free_arm=free, look_joints=list(joints), centring_px=score, case_measured='board' in fresh.get('poses', {}),
+                       home_result=home)
