+def silhouette(rgb):
+    """Dim chromatic pixels: foreground's chromatic test made brightness-invariant.
+
+    A shaded side of a pale part keeps its hue but drops below foreground's
+    absolute spread; its edge is shading, not the part's outline. These
+    pixels only extend a fitted part's own outline (object_masks); every
+    support gate still uses foreground().
+    """
+    fg=foreground(rgb)
+    high=rgb.max(axis=2).astype(np.int32);low=rgb.min(axis=2).astype(np.int32)
+    return ((((high-low)*255>24*high)&(high>35))&(fg==0)).astype(np.uint8)
+
